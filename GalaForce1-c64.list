001CA6  2  60            RTS
001CA7  2               
001CA7  2               ;; ]
001CA7  2               ;; PRINT"Routine 4 from &";~B%;" to &";~P%-1;" (";P%-B%;")"
001CA7  2               ;; PAGE=&5800
001CA7  2               ;; RETURN
001CA7  2               
001CA7  1               .include "src-c64/STARS.asm"
001CA7  2               ;;
001CA7  2               ;; Galaforce 1 ( BBC Micro ) from the original 6502 source code, adapted to assemble using beebasm
001CA7  2               ;;
001CA7  2               ;; (c) Kevin Edwards 1986-2019
001CA7  2               ;;
001CA7  2               ;; Twitter @KevEdwardsRetro
001CA7  2               ;;
001CA7  2               
001CA7  2               ;; Moving star field for the C64 multicolor bitmap screen (see INIT.asm's
001CA7  2               ;; file header for the overall bitmap-mode architecture).
001CA7  2               ;;
001CA7  2               ;; This is NOT a line-by-line port of the BBC routine below it used to be.
001CA7  2               ;; The original BBC code addresses screen memory via 6502 indexed-indirect
001CA7  2               ;; ((stardat,X)) addressing, which requires the stardat pointer table to
001CA7  2               ;; live in zero page - noted back when stardat was first declared here as
001CA7  2               ;; not fitting in zero page on the C64 (see Master-c64.mak.asm). Without
001CA7  2               ;; that trick the BBC address-arithmetic (the EOR #$40 / ADC #$79 / AND
001CA7  2               ;; #$F8 dance in its old movestars) doesn't carry over either - that was
001CA7  2               ;; exploiting specifics of BBC MODE 2's screen address layout. The C64's
001CA7  2               ;; bitmap layout is simpler (flat $6000-$7F3F, 8 bytes/cell, 40 cells/row,
001CA7  2               ;; row stride 320 bytes), so the replacement logic below is more direct.
001CA7  2               ;;
001CA7  2               ;; Each star is (screen address lo/hi, XOR-plot byte) in stardat, same
001CA7  2               ;; layout BBC used, but dereferenced via a zero-page scratch pointer
001CA7  2               ;; (temp3) copied in per star rather than requiring stardat itself to be
001CA7  2               ;; zero page. Falling is a screen-address walk: +1 per frame (one
001CA7  2               ;; scanline down within the current 8-scanline column-block), or +313
001CA7  2               ;; when the low 3 bits of the address hit 7 (bottom of the block) to jump
001CA7  2               ;; to the same column one character-row down (320 - 7 = 313). A parallel
001CA7  2               ;; star_rowcnt byte per star (reusing the same 3-slot stride as stardat,
001CA7  2               ;; for simplicity) counts rows moved since spawn so movestars knows when
001CA7  2               ;; a star has fallen through the bottom of the band and should respawn at
001CA7  2               ;; the top, without ever having to decode a row/column back out of a raw
001CA7  2               ;; address.
001CA7  2               ;;
001CA7  2               ;; Only 3 non-background colors are available at once (screen-matrix
001CA7  2               ;; hi-nibble/lo-nibble + color RAM low-nibble - see the background-clear
001CA7  2               ;; setup in INIT.asm's exec), so each star occupies one fixed pixel slot
001CA7  2               ;; within its byte (0-3, i.e. one of the 4 color-pixels a byte holds -
001CA7  2               ;; chosen once at spawn and kept for the star's whole life, see
001CA7  2               ;; star_pick_slot/star_slot) and shows a color PATTERN there that is
001CA7  2               ;; re-rolled periodically (star_pick_pattern), including going to 0
001CA7  2               ;; (black/background - a "twinkle off"). Keeping the slot fixed and only
001CA7  2               ;; changing the pattern is what keeps a falling star's on-screen column
001CA7  2               ;; steady - re-picking the slot every frame is what earlier made stars
001CA7  2               ;; visibly jump sideways as they fell.
001CA7  2               ;;
001CA7  2               ;; rand (below) is the same generator BOMBS/ALIENS use elsewhere and is
001CA7  2               ;; left untouched, but on its own it produces a visibly correlated
001CA7  2               ;; sequence here: interrupts are off for the whole of exec (see INIT.asm),
001CA7  2               ;; so the "EOR $FC" it reads from zero page never changes run to run, and
001CA7  2               ;; calling it several times in a tight, fixed instruction sequence (as
001CA7  2               ;; star_init/movestars do, once per star) means consecutive draws stay
001CA7  2               ;; close together in its state - visible as the stars starting out in a
001CA7  2               ;; diagonal line. Rather than touch the shared generator (other systems
001CA7  2               ;; depend on its exact behavior), every draw here is additionally EOR'd
001CA7  2               ;; with $D012 (the VIC raster line) - a free-running hardware counter
001CA7  2               ;; that keeps moving regardless of interrupts and has advanced by a
001CA7  2               ;; different, code-flow-independent amount at each call site - see
001CA7  2               ;; star_rand_mask.
001CA7  2               ;;
001CA7  2               ;; Full screen (rows 0-24): this deliberately overlaps the title, score
001CA7  2               ;; bar, flags etc., which will get their pixels/cells disturbed by
001CA7  2               ;; passing stars - accepted tradeoff, not a bug.
001CA7  2               
001CA7  2               STAR_COUNT   = 24
001CA7  2               BAND_MIN_ROW = 0
001CA7  2               BAND_ROWS    = 25
001CA7  2               
001CA7  2               ; Stars advance once every STAR_SLOWDOWN calls to movestars (~1/3 speed
001CA7  2               ; at a 1-call/frame cadence). Color only changes once every
001CA7  2               ; STAR_COLOR_SLOWDOWN of THOSE moves, i.e. noticeably slower than the
001CA7  2               ; falling motion itself - see the two counters at the top of movestars.
001CA7  2               STAR_SLOWDOWN       = 3
001CA7  2               STAR_COLOR_SLOWDOWN = 6
001CA7  2               
001CA7  2               rand:
001CA7  2  A5 rr         LDA  rand1
001CA9  2  29 48         AND  #$48
001CAB  2  45 FC         EOR  $FC
001CAD  2  69 38         ADC  #$38
001CAF  2  0A            ASL  A
001CB0  2  0A            ASL  A
001CB1  2  26 rr         ROL  rand1+2
001CB3  2  26 rr         ROL  rand1+1
001CB5  2  26 rr         ROL  rand1
001CB7  2  A5 rr         LDA  rand1
001CB9  2  60            RTS
001CBA  2               
001CBA  2               ; star_rand_mask: returns rand() EOR $D012 in A (see the file header note
001CBA  2               ; on why) - callers AND this with whatever range mask they need.
001CBA  2               ; Preserves X.
001CBA  2               star_rand_mask:
001CBA  2  20 A7 1C      JSR  rand
001CBD  2  4D 12 D0      EOR  $D012
001CC0  2  60            RTS
001CC1  2               
001CC1  2               ; star_pick_slot: X = star's stardat index (0,3,6,...). Picks a random
001CC1  2               ; fixed pixel slot (0, 2, 4 or 6 - the bit-shift for one of the 4
001CC1  2               ; color-pixels in a screen byte) for this star and stores it in
001CC1  2               ; star_slot,X. Called once per spawn/respawn, never per frame - this is
001CC1  2               ; what keeps a falling star in the same screen column. Preserves X.
001CC1  2               star_pick_slot:
001CC1  2  20 BA 1C      JSR  star_rand_mask
001CC4  2  29 03         AND  #3
001CC6  2  0A            ASL  A
001CC7  2  9D 71 31      STA  star_slot,x
001CCA  2  60            RTS
001CCB  2               
001CCB  2               ; star_pick_pattern: X = star's stardat index. Rolls a fresh 2-bit color
001CCB  2               ; pattern (0-3; 0 = black/background, a twinkle "off") at this star's
001CCB  2               ; already-chosen fixed slot (star_slot,X) and stores the resulting byte
001CCB  2               ; in stardat+2,X. Preserves X.
001CCB  2               star_pick_pattern:
001CCB  2  20 BA 1C      JSR  star_rand_mask
001CCE  2  29 03         AND  #3
001CD0  2  BC 71 31      LDY  star_slot,x
001CD3  2               scp_shift:
001CD3  2  C0 00         CPY  #0
001CD5  2  F0 07         BEQ  scp_done
001CD7  2  0A            ASL  A
001CD8  2  0A            ASL  A
001CD9  2  88            DEY
001CDA  2  88            DEY
001CDB  2  4C D3 1C      JMP  scp_shift
001CDE  2               scp_done:
001CDE  2  9D B9 30      STA  stardat+2,x
001CE1  2  60            RTS
001CE2  2               
001CE2  2               ; star_respawn_top: (re)spawns star X at the top of the band (row
001CE2  2               ; BAND_MIN_ROW, scanline 0) with a random column and a fresh slot+color
001CE2  2               ; (a brand new star gets its full look immediately, independent of the
001CE2  2               ; color-slowdown timing in movestars). Preserves X.
001CE2  2               star_respawn_top:
001CE2  2  A9 00         LDA  #0
001CE4  2  9D 14 31      STA  star_rowcnt,x
001CE7  2               srt_col:
001CE7  2  20 BA 1C      JSR  star_rand_mask
001CEA  2  29 3F         AND  #$3F
001CEC  2  C9 28         CMP  #40
001CEE  2  B0 F7         BCS  srt_col
001CF0  2  85 rr         STA  temp4
001CF2  2  A9 00         LDA  #0
001CF4  2  85 rr         STA  temp4+1
001CF6  2  06 rr         ASL  temp4
001CF8  2  26 rr         ROL  temp4+1
001CFA  2  06 rr         ASL  temp4
001CFC  2  26 rr         ROL  temp4+1
001CFE  2  06 rr         ASL  temp4
001D00  2  26 rr         ROL  temp4+1            ; temp4 (word) = col * 8
001D02  2  A9 00         LDA  #<($6000+BAND_MIN_ROW*320)
001D04  2  18            CLC
001D05  2  65 rr         ADC  temp4
001D07  2  9D B7 30      STA  stardat,x
001D0A  2  A9 60         LDA  #>($6000+BAND_MIN_ROW*320)
001D0C  2  65 rr         ADC  temp4+1
001D0E  2  9D B8 30      STA  stardat+1,x
001D11  2  20 C1 1C      JSR  star_pick_slot
001D14  2  20 CB 1C      JSR  star_pick_pattern
001D17  2  60            RTS
001D18  2               
001D18  2               ; star_init: populates all STAR_COUNT stars at random positions spread
001D18  2               ; through the whole band (so it isn't empty/bunched at the top the first
001D18  2               ; time the screen appears) with random slots/colors, and plots them.
001D18  2               ; Called once at startup - the per-star row multiply below is too slow
001D18  2               ; to repeat every frame, which is why movestars (below) never recomputes
001D18  2               ; a row from scratch, only ever adds a fixed offset.
001D18  2               star_init:
001D18  2  A2 00         LDX  #0
001D1A  2               si_loop:
001D1A  2               si_row:
001D1A  2  20 BA 1C      JSR  star_rand_mask
001D1D  2  29 1F         AND  #31                ; mask must cover the full BAND_ROWS range (now
001D1F  2                                         ; 0-24, full screen) before the reject-retry below
001D1F  2  C9 19         CMP  #BAND_ROWS
001D21  2  B0 F7         BCS  si_row
001D23  2  9D 14 31      STA  star_rowcnt,x
001D26  2  85 rr         STA  temp1              ; temp1 = row offset within the band (scratch -
001D28  2                                         ; see INIT.asm's zero-page usage note; free here,
001D28  2                                         ; nothing else runs during star_init)
001D28  2  A9 00         LDA  #<($6000+BAND_MIN_ROW*320)
001D2A  2  9D B7 30      STA  stardat,x
001D2D  2  A9 60         LDA  #>($6000+BAND_MIN_ROW*320)
001D2F  2  9D B8 30      STA  stardat+1,x
001D32  2  A5 rr         LDA  temp1
001D34  2  F0 15         BEQ  si_row_added
001D36  2               si_row_loop:
001D36  2  BD B7 30      LDA  stardat,x
001D39  2  18            CLC
001D3A  2  69 40         ADC  #<320
001D3C  2  9D B7 30      STA  stardat,x
001D3F  2  BD B8 30      LDA  stardat+1,x
001D42  2  69 01         ADC  #>320
001D44  2  9D B8 30      STA  stardat+1,x
001D47  2  C6 rr         DEC  temp1
001D49  2  D0 EB         BNE  si_row_loop
001D4B  2               si_row_added:
001D4B  2               si_col:
001D4B  2  20 BA 1C      JSR  star_rand_mask
001D4E  2  29 3F         AND  #$3F
001D50  2  C9 28         CMP  #40
001D52  2  B0 F7         BCS  si_col
001D54  2  85 rr         STA  temp4
001D56  2  A9 00         LDA  #0
001D58  2  85 rr         STA  temp4+1
001D5A  2  06 rr         ASL  temp4
001D5C  2  26 rr         ROL  temp4+1
001D5E  2  06 rr         ASL  temp4
001D60  2  26 rr         ROL  temp4+1
001D62  2  06 rr         ASL  temp4
001D64  2  26 rr         ROL  temp4+1            ; temp4 (word) = col * 8
001D66  2  BD B7 30      LDA  stardat,x
001D69  2  18            CLC
001D6A  2  65 rr         ADC  temp4
001D6C  2  9D B7 30      STA  stardat,x
001D6F  2  BD B8 30      LDA  stardat+1,x
001D72  2  65 rr         ADC  temp4+1
001D74  2  9D B8 30      STA  stardat+1,x
001D77  2               si_scan:
001D77  2  20 BA 1C      JSR  star_rand_mask
001D7A  2  29 07         AND  #7
001D7C  2  85 rr         STA  temp4
001D7E  2  BD B7 30      LDA  stardat,x
001D81  2  18            CLC
001D82  2  65 rr         ADC  temp4
001D84  2  9D B7 30      STA  stardat,x
001D87  2  BD B8 30      LDA  stardat+1,x
001D8A  2  69 00         ADC  #0
001D8C  2  9D B8 30      STA  stardat+1,x
001D8F  2               
001D8F  2  20 C1 1C      JSR  star_pick_slot
001D92  2  20 CB 1C      JSR  star_pick_pattern
001D95  2               
001D95  2  BD B7 30      LDA  stardat,x
001D98  2  85 rr         STA  temp3
001D9A  2  BD B8 30      LDA  stardat+1,x
001D9D  2  85 rr         STA  temp3+1
001D9F  2  A0 00         LDY  #0
001DA1  2  BD B9 30      LDA  stardat+2,x
001DA4  2  51 rr         EOR  (temp3),y
001DA6  2  91 rr         STA  (temp3),y
001DA8  2               
001DA8  2  E8            INX
001DA9  2  E8            INX
001DAA  2  E8            INX
001DAB  2  E0 48         CPX  #(STAR_COUNT*3)
001DAD  2  F0 03         BEQ  si_done
001DAF  2  4C 1A 1D      JMP  si_loop
001DB2  2               si_done:
001DB2  2  60            RTS
001DB3  2               
001DB3  2               ; movestars: called once per frame. Only actually advances the stars
001DB3  2               ; every STAR_SLOWDOWN'th call (~1/3 speed); of those moves, only every
001DB3  2               ; STAR_COLOR_SLOWDOWN'th also re-rolls color (each star's fixed pixel
001DB3  2               ; slot - not its color - so it doesn't jump sideways), so the flicker is
001DB3  2               ; noticeably slower than the fall. A star that respawns this tick always
001DB3  2               ; gets a fresh look immediately regardless of the color-tick timing (see
001DB3  2               ; star_respawn_top).
001DB3  2               movestars:
001DB3  2  EE 50 1E      INC  star_frame_count
001DB6  2  AD 50 1E      LDA  star_frame_count
001DB9  2  C9 03         CMP  #STAR_SLOWDOWN
001DBB  2  90 08         BCC  ms_skip
001DBD  2  A9 00         LDA  #0
001DBF  2  8D 50 1E      STA  star_frame_count
001DC2  2  4C C6 1D      JMP  ms_run
001DC5  2               ms_skip:
001DC5  2  60            RTS
001DC6  2               
001DC6  2               ms_run:
001DC6  2  EE 51 1E      INC  star_color_count
001DC9  2  AD 51 1E      LDA  star_color_count
001DCC  2  C9 06         CMP  #STAR_COLOR_SLOWDOWN
001DCE  2  90 0D         BCC  ms_no_recolor
001DD0  2  A9 00         LDA  #0
001DD2  2  8D 51 1E      STA  star_color_count
001DD5  2  A9 01         LDA  #1
001DD7  2  8D 52 1E      STA  ms_recolor_flag
001DDA  2  4C E2 1D      JMP  ms_start
001DDD  2               ms_no_recolor:
001DDD  2  A9 00         LDA  #0
001DDF  2  8D 52 1E      STA  ms_recolor_flag
001DE2  2               ms_start:
001DE2  2  A2 00         LDX  #0
001DE4  2               ms_loop:
001DE4  2  BD B7 30      LDA  stardat,x
001DE7  2  85 rr         STA  temp3
001DE9  2  BD B8 30      LDA  stardat+1,x
001DEC  2  85 rr         STA  temp3+1
001DEE  2  A0 00         LDY  #0
001DF0  2  BD B9 30      LDA  stardat+2,x
001DF3  2  51 rr         EOR  (temp3),y
001DF5  2  91 rr         STA  (temp3),y          ; erase at the current position
001DF7  2               
001DF7  2  BD B7 30      LDA  stardat,x
001DFA  2  29 07         AND  #7
001DFC  2  C9 07         CMP  #7
001DFE  2  F0 06         BEQ  ms_wrap_row
001E00  2  FE B7 30      INC  stardat,x
001E03  2  4C 2A 1E      JMP  ms_pick_color
001E06  2               
001E06  2               ms_wrap_row:
001E06  2  BD 14 31      LDA  star_rowcnt,x
001E09  2  C9 18         CMP  #(BAND_ROWS-1)
001E0B  2  B0 17         BCS  ms_respawn
001E0D  2  FE 14 31      INC  star_rowcnt,x
001E10  2  BD B7 30      LDA  stardat,x
001E13  2  18            CLC
001E14  2  69 39         ADC  #<(320-7)
001E16  2  9D B7 30      STA  stardat,x
001E19  2  BD B8 30      LDA  stardat+1,x
001E1C  2  69 01         ADC  #>(320-7)
001E1E  2  9D B8 30      STA  stardat+1,x
001E21  2  4C 2A 1E      JMP  ms_pick_color
001E24  2               
001E24  2               ms_respawn:
001E24  2  20 E2 1C      JSR  star_respawn_top
001E27  2  4C 32 1E      JMP  ms_draw            ; star_respawn_top already picked slot+pattern
001E2A  2               
001E2A  2               ms_pick_color:
001E2A  2  AD 52 1E      LDA  ms_recolor_flag
001E2D  2  F0 03         BEQ  ms_draw
001E2F  2  20 CB 1C      JSR  star_pick_pattern
001E32  2               
001E32  2               ms_draw:
001E32  2  BD B7 30      LDA  stardat,x
001E35  2  85 rr         STA  temp3
001E37  2  BD B8 30      LDA  stardat+1,x
001E3A  2  85 rr         STA  temp3+1
001E3C  2  A0 00         LDY  #0
001E3E  2  BD B9 30      LDA  stardat+2,x
001E41  2  51 rr         EOR  (temp3),y
001E43  2  91 rr         STA  (temp3),y          ; redraw at the new position
001E45  2               
001E45  2  E8            INX
001E46  2  E8            INX
001E47  2  E8            INX
001E48  2  E0 48         CPX  #(STAR_COUNT*3)
001E4A  2  F0 03         BEQ  ms_done
001E4C  2  4C E4 1D      JMP  ms_loop
001E4F  2               ms_done:
001E4F  2  60            RTS
001E50  2               
001E50  2               star_frame_count:
001E50  2  00            .byte 0
001E51  2               star_color_count:
001E51  2  00            .byte 0
001E52  2               ms_recolor_flag:
001E52  2  00            .byte 0
001E53  2               
