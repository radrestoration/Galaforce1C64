001BBE  2               ;;
001BBE  2               ;; Galaforce 1 ( BBC Micro ) from the original 6502 source code, adapted to assemble using beebasm
001BBE  2               ;;
001BBE  2               ;; (c) Kevin Edwards 1986-2019
001BBE  2               ;;
