0008FF  2               ;; C64 startup, title screen, and the minimal playable game loop
0008FF  2               ;; (splash -> press SPACE/RETURN -> ship + stars + bullets, Z/X/:/​/ to
0008FF  2               ;; move, RETURN to fire).
0008FF  2               ;;
0008FF  2               ;; Everything on screen (text, stars, ship, alien, flags, lives icon,
0008FF  2               ;; bullets) is plotted as real bitmap pixels in VIC-II MULTICOLOR bitmap
0008FF  2               ;; mode: bank 1, screen-matrix at $4000 (per-cell colors - hi-nibble and
0008FF  2               ;; lo-nibble select 2 of the cell's 3 non-background colors, color RAM's
0008FF  2               ;; low-nibble the 3rd; see clear_screen), bitmap data at $6000 (320x200,
0008FF  2               ;; 8 bytes/cell, 40x25 cells, 2 bits/pixel = 160 color-pixels wide).
0008FF  2               ;; Chosen over standard (hi-res) bitmap mode because C64 multicolor's
0008FF  2               ;; color-pixel grid (160 wide) is dimensionally identical to BBC MODE 2's
0008FF  2               ;; own pixel grid (also 160 wide, also "fat"/double-width pixels) - real
0008FF  2               ;; BBC font/graphics data maps at NATIVE width with no stretching, and
0008FF  2               ;; each cell gets 3 independently-settable colors (not just 1), much
0008FF  2               ;; closer to BBC MODE 2's real per-pixel color density than hi-res
0008FF  2               ;; bitmap's "background + 1 foreground per cell" would allow. The cost -
0008FF  2               ;; shared with every C64 multicolor mode - is half the hi-res horizontal
0008FF  2               ;; resolution, screen-wide.
0008FF  2               ;;
0008FF  2               ;; Only 3 non-background colors exist at once, and they're set the SAME
0008FF  2               ;; for every plain background cell (clear_screen). Anything needing more
0008FF  2               ;; colors than that (the ship, alien, lives icon) gets its OWN per-cell
0008FF  2               ;; screen-matrix/color-RAM override instead of using the shared
0008FF  2               ;; background palette - see draw_ship/draw_alien/draw_one_lifeicon - and
0008FF  2               ;; must therefore fully own whichever cells it's drawn into (a moving
0008FF  2               ;; object's erase step overwrites those cells outright, not XOR, so nothing
0008FF  2               ;; using the shared background palette - a star, a bullet - can safely
0008FF  2               ;; share a cell with one of these without the object's next move
0008FF  2               ;; clobbering it; see fire_bullet_if_requested's comment on the bug this
0008FF  2               ;; caused once already). Anything that reuses the shared background
0008FF  2               ;; palette (stars, bullets) draws via XOR instead, needing no per-cell
0008FF  2               ;; color writes at all, and CAN move through arbitrary cells freely.
0008FF  2               ;;
0008FF  2               ;; Moving objects (ship, bullets; aliens once they move) are erased (re-
0008FF  2               ;; plot the background) at their old position and redrawn at the new one
0008FF  2               ;; every frame they move - real CPU cost hardware sprites don't charge.
0008FF  2               ;; Budget for this per-object as more of them appear at once; measured
0008FF  2               ;; BBC vs. C64 effective speeds are much closer than the raw 2MHz-vs-1MHz
0008FF  2               ;; clocks suggest once RAM access and badline overhead are accounted for
0008FF  2               ;; (BBC's 6502A only hits 2MHz for ROM; RAM access is ~1MHz regardless of
0008FF  2               ;; video mode - see https://www.everygamegoing.com/larticle/speed-the-big-difference-000/52365
0008FF  2               ;; and https://stardot.org.uk/forums/viewtopic.php?t=11997), but it's
0008FF  2               ;; still the resource to watch as more systems interact (alien animation,
0008FF  2               ;; collision detection, more bullets).
0008FF  2               ;;
0008FF  2               ;; Keyboard input is read directly through the CIA1 keyboard matrix
0008FF  2               ;; ($DC00 selects a column by clearing its bit; $DC01 then reads that
0008FF  2               ;; column's row switches, 0 = pressed) - see check_start_key and
0008FF  2               ;; handle_ship_input for the specific column/row masks in use.
0008FF  2               ;;
0008FF  2               ;; Zero-page scratch usage (see ZPWORK.asm) is shared and reused freely
0008FF  2               ;; across every routine below, not per-routine private state: temp2/
0008FF  2               ;; temp3/temp4 are typically source-string/dest-bitmap/dest-screen-matrix
0008FF  2               ;; pointers during printing, or bitmap/screen-matrix/color-RAM addresses
0008FF  2               ;; elsewhere; colour holds a plain 0-15 foreground value; length and
0008FF  2               ;; temp1 are loop counters/scratch bytes reused for whatever the current
0008FF  2               ;; routine needs (a row index, a column, a countdown) - never assume a
0008FF  2               ;; value in any of these survives a call to another routine. None of
0008FF  2               ;; this is used by any other (still-unconverted) BBC-derived system yet.
0008FF  2               
0008FF  2               exec:
0008FF  2  78               sei
000900  2               
000900  2                   ; VIC bank 1 ($4000-$7FFF): screen-matrix at $4000 (bank offset 0),
000900  2                   ; bitmap at $6000 (bank offset $2000, i.e. $D018 bit 3 = 1). MULTICOLOR
000900  2                   ; bitmap mode: $D011 BMM=1, $D016 MCM=1. Chosen over standard (hi-res)
000900  2                   ; bitmap mode because C64 multicolor's color-pixel grid (160 wide) is
000900  2                   ; dimensionally identical to BBC MODE 2's own pixel grid (also 160
000900  2                   ; wide, also "fat"/double-width pixels) - the real font/graphics data
000900  2                   ; can map at NATIVE width with no artificial stretching, and each
000900  2                   ; cell gets 3 independently-settable colors (not just 1), matching
000900  2                   ; BBC MODE 2's real per-pixel color density far better than hi-res
000900  2                   ; bitmap did. The cost - shared with every C64 multicolor mode - is
000900  2                   ; half the hi-res horizontal resolution, screen-wide.
000900  2  AD 00 DD         lda $DD00
000903  2  29 FC            and #$FC
000905  2  09 02            ora #$02
000907  2  8D 00 DD         sta $DD00
00090A  2  A9 08            lda #$08
00090C  2  8D 18 D0         sta $D018
00090F  2  A9 3B            lda #$3B            ; DEN=1,RSEL=1,YSCROLL=3,BMM=1,ECM=0,raster hi=0
000911  2  8D 11 D0         sta $D011
000914  2  AD 16 D0         lda $D016
000917  2  09 10            ora #$10             ; MCM on
000919  2  8D 16 D0         sta $D016
00091C  2  A9 01            lda #$01
00091E  2  8D 20 D0         sta $D020            ; border white - shows the visible-area edges
000921  2  A9 00            lda #$00
000923  2  8D 21 D0         sta $D021             ; background black
000926  2               
000926  2  20 27 0D         jsr clear_screen
000929  2               
000929  2                   ; --- Title: GALAFORCE, 3x2 cells/letter (double width, double height -
000929  2                   ; see blit_title_char), red, rows 4-5. 9 letters x 3 cells = 27 cells;
000929  2                   ; (40-27)/2 = 6 start col, centering it same as before. col*8 (max
000929  2                   ; 30*8=240) still fits in one byte, and since $6500's low byte is 0,
000929  2                   ; adding col*8 to it never carries - temp3's high byte stays $65. ---
000929  2  A2 00            ldx #0
00092B  2               draw_title_loop:
00092B  2  8A               txa
00092C  2  85 rr            sta length            ; length = index (temporary)
00092E  2  0A               asl a                 ; A = index*2
00092F  2  18               clc
000930  2  65 rr            adc length             ; A = index*2 + index = index*3
000932  2  18               clc
000933  2  69 06            adc #6                  ; A = index*3 + 6
000935  2  85 rr            sta length               ; length = col
000937  2  A5 rr            lda length
000939  2  0A               asl a
00093A  2  0A               asl a
00093B  2  0A               asl a
00093C  2  85 rr            sta temp3              ; low byte = col*8
00093E  2  A9 65            lda #$65
000940  2  85 rr            sta temp3+1
000942  2  A5 rr            lda length
000944  2  18               clc
000945  2  69 A0            adc #<($4000+4*40)
000947  2  85 rr            sta temp4
000949  2  A9 40            lda #>($4000+4*40)
00094B  2  69 00            adc #0
00094D  2  85 rr            sta temp4+1
00094F  2  AD A7 12         lda colour_title
000952  2  85 rr            sta colour
000954  2  8A               txa
000955  2  48               pha                    ; blit_title_char uses X as scratch - preserve
000956  2  BD 9E 12         lda title_letter_codes,x  ; our loop index across the call (X unchanged
000959  2  20 8E 10         jsr blit_title_char        ; by txa/pha above, so ,x addressing here
00095C  2  68               pla                          ; still uses the right index)
00095D  2  AA               tax
00095E  2  E8               inx
00095F  2  E0 09            cpx #9
000961  2  D0 C8            bne draw_title_loop
000963  2               
000963  2  20 D6 0E         jsr draw_score_bar
000966  2  20 0E 0F         jsr draw_body_text
000969  2               
000969  2  20 72 0D         jsr draw_level_flags
00096C  2               
00096C  2  20 18 1D         jsr star_init
00096F  2               
00096F  2               ; --- Title screen: stars animate, wait for SPACE or RETURN to start. One
00096F  2               ; raster-poll per frame (line 250 - below the visible 200 lines, so a
00096F  2               ; single 8-bit compare against $D012 is enough). ---
00096F  2               title_wait_loop:
00096F  2  A9 FA            lda #250
000971  2               twl_wait_raster:
000971  2  CD 12 D0         cmp $D012
000974  2  D0 FB            bne twl_wait_raster
000976  2  20 B3 1D         jsr movestars
000979  2  20 C9 09         jsr check_start_key
00097C  2  D0 F1            bne title_wait_loop
00097E  2               
00097E  2               ; --- Game start: wipe the title text, fresh stars, drop the ship in at
00097E  2               ; its start column, and redraw the score bar / level flags / lives icon
00097E  2               ; on the now-blank game screen (clear_screen wiped them along with
00097E  2               ; everything else). ---
00097E  2  20 27 0D         jsr clear_screen
000981  2  20 18 1D         jsr star_init
000984  2  20 D6 0E         jsr draw_score_bar
000987  2  20 72 0D         jsr draw_level_flags
00098A  2  20 42 0E         jsr draw_lives_icons
00098D  2  20 85 0B         jsr draw_alien
000990  2  A9 12            lda #SHIP_START_COL
000992  2  8D 67 0A         sta ship_col
000995  2  A9 14            lda #SHIP_START_ROW
000997  2  8D 68 0A         sta ship_row
00099A  2  20 65 0C         jsr draw_ship
00099D  2               
00099D  2                   ; Prime fire_key_prev with RETURN's actual current state, so if the
00099D  2                   ; player started the game by pressing RETURN (still held on this
00099D  2                   ; very first frame), fire_bullet_if_requested's edge trigger sees it
00099D  2                   ; as "already down", not a fresh press, and doesn't fire immediately.
00099D  2  A9 FE            lda #$FE               ; clear bit0: select column 0 (RETURN's column)
00099F  2  8D 00 DC         sta $DC00
0009A2  2  AD 01 DC         lda $DC01
0009A5  2  29 02            and #$02                 ; row bit 1 = RETURN
0009A7  2  F0 05            beq gs_return_held
0009A9  2  A9 00            lda #0
0009AB  2  4C B0 09         jmp gs_store_fire_prev
0009AE  2               gs_return_held:
0009AE  2  A9 01            lda #1
0009B0  2               gs_store_fire_prev:
0009B0  2  8D 7E 0A         sta fire_key_prev
0009B3  2               
0009B3  2               game_loop:
0009B3  2  A9 FA            lda #250
0009B5  2               gl_wait_raster:
0009B5  2  CD 12 D0         cmp $D012
0009B8  2  D0 FB            bne gl_wait_raster
0009BA  2  20 B3 1D         jsr movestars
0009BD  2  20 E7 09         jsr handle_ship_input
0009C0  2  20 D7 0A         jsr fire_bullet_if_requested
0009C3  2  20 23 0B         jsr move_bullets
0009C6  2  4C B3 09         jmp game_loop
0009C9  2               
0009C9  2               ; check_start_key: returns with the Z flag set (BEQ taken by the caller)
0009C9  2               ; if SPACE or RETURN is currently held, clear otherwise. See the C64
0009C9  2               ; keyboard matrix note by handle_ship_input for how CIA1 is used here.
0009C9  2               check_start_key:
0009C9  2  A9 7F            lda #$7F              ; clear bit7: select column 7 (SPACE's column)
0009CB  2  8D 00 DC         sta $DC00
0009CE  2  AD 01 DC         lda $DC01
0009D1  2  29 10            and #$10                ; row bit 4 = SPACE
0009D3  2  F0 0F            beq csk_pressed
0009D5  2  A9 FE            lda #$FE              ; clear bit0: select column 0 (RETURN's column)
0009D7  2  8D 00 DC         sta $DC00
0009DA  2  AD 01 DC         lda $DC01
0009DD  2  29 02            and #$02                ; row bit 1 = RETURN
0009DF  2  F0 03            beq csk_pressed
0009E1  2  A9 01            lda #1
0009E3  2  60               rts
0009E4  2               csk_pressed:
0009E4  2  A9 00            lda #0
0009E6  2  60               rts
0009E7  2               
0009E7  2               ; handle_ship_input: polls Z/X (left/right) and ":"/"/" (up/down - see
0009E7  2               ; below) via the CIA1 keyboard matrix ($DC00 selects a column by
0009E7  2               ; clearing its bit; $DC01 then reads that column's row switches, 0 =
0009E7  2               ; pressed) and moves the ship one cell per call, throttled to every
0009E7  2               ; SHIP_MOVE_SLOWDOWN'th call so it doesn't outrun the eye at 50/60 calls
0009E7  2               ; a second. Erase-then-redraw, same "just overwrite the cells" approach
0009E7  2               ; as the rest of this file - the ship isn't blended with whatever star
0009E7  2               ; happened to be under it.
0009E7  2               ;
0009E7  2               ; The C64 keyboard has no dedicated unshifted apostrophe key the way a
0009E7  2               ; PC one does, so "up" is mapped to the physical key that sits in the
0009E7  2               ; same spot on a real C64 keyboard: ":" (column 5, row bit 5). "/" is a
0009E7  2               ; real, unshifted C64 key as-is (column 6, row bit 7) and needs no
0009E7  2               ; substitution. If VICE's keymap sends host "'" somewhere else, this is
0009E7  2               ; a 2-constant fix (the LDA #$DF / AND #$20 pair below).
0009E7  2               SHIP_MOVE_SLOWDOWN = 4
0009E7  2               
0009E7  2               handle_ship_input:
0009E7  2  EE 69 0A         inc ship_move_count
0009EA  2  AD 69 0A         lda ship_move_count
0009ED  2  C9 04            cmp #SHIP_MOVE_SLOWDOWN
0009EF  2  90 75            bcc hsi_done
0009F1  2  A9 00            lda #0
0009F3  2  8D 69 0A         sta ship_move_count
0009F6  2               
0009F6  2  A9 FD            lda #$FD               ; clear bit1: select column 1 (Z's column)
0009F8  2  8D 00 DC         sta $DC00
0009FB  2  AD 01 DC         lda $DC01
0009FE  2  29 10            and #$10                 ; row bit 4 = Z
000A00  2  D0 10            bne hsi_check_x
000A02  2  AD 67 0A         lda ship_col
000A05  2  C9 00            cmp #SHIP_MIN_COL
000A07  2  F0 09            beq hsi_check_x
000A09  2  20 C9 0C         jsr erase_ship
000A0C  2  CE 67 0A         dec ship_col
000A0F  2  20 65 0C         jsr draw_ship
000A12  2               
000A12  2               hsi_check_x:
000A12  2  A9 FB            lda #$FB               ; clear bit2: select column 2 (X's column)
000A14  2  8D 00 DC         sta $DC00
000A17  2  AD 01 DC         lda $DC01
000A1A  2  29 80            and #$80                 ; row bit 7 = X
000A1C  2  D0 10            bne hsi_check_up
000A1E  2  AD 67 0A         lda ship_col
000A21  2  C9 25            cmp #SHIP_MAX_COL
000A23  2  F0 09            beq hsi_check_up
000A25  2  20 C9 0C         jsr erase_ship
000A28  2  EE 67 0A         inc ship_col
000A2B  2  20 65 0C         jsr draw_ship
000A2E  2               
000A2E  2               hsi_check_up:
000A2E  2  A9 DF            lda #$DF               ; clear bit5: select column 5 (":"'s column)
000A30  2  8D 00 DC         sta $DC00
000A33  2  AD 01 DC         lda $DC01
000A36  2  29 20            and #$20                  ; row bit 5 = ":"
000A38  2  D0 10            bne hsi_check_down
000A3A  2  AD 68 0A         lda ship_row
000A3D  2  C9 00            cmp #SHIP_MIN_ROW
000A3F  2  F0 09            beq hsi_check_down
000A41  2  20 C9 0C         jsr erase_ship
000A44  2  CE 68 0A         dec ship_row
000A47  2  20 65 0C         jsr draw_ship
000A4A  2               
000A4A  2               hsi_check_down:
000A4A  2  A9 BF            lda #$BF               ; clear bit6: select column 6 ("/"'s column)
000A4C  2  8D 00 DC         sta $DC00
000A4F  2  AD 01 DC         lda $DC01
000A52  2  29 80            and #$80                  ; row bit 7 = "/"
000A54  2  D0 10            bne hsi_done
000A56  2  AD 68 0A         lda ship_row
000A59  2  C9 17            cmp #SHIP_MAX_ROW
000A5B  2  F0 09            beq hsi_done
000A5D  2  20 C9 0C         jsr erase_ship
000A60  2  EE 68 0A         inc ship_row
000A63  2  20 65 0C         jsr draw_ship
000A66  2               
000A66  2               hsi_done:
000A66  2  60               rts
000A67  2               
000A67  2               ship_col:
000A67  2  00            .byte 0
000A68  2               ship_row:
000A68  2  00            .byte 0
000A69  2               ship_move_count:
000A69  2  00            .byte 0
000A6A  2               
000A6A  2               ; --- Bullets: decoded from the real BBC data, not invented. BOMBS1.asm's
000A6A  2               ; move_bomb plots bombgra (EQUB 21,21,21,21,21,21,51,1 - one BBC byte-
000A6A  2               ; column, 8 scanlines) straight into (screen),Y for Y=7..0, i.e. Y IS the
000A6A  2               ; scanline offset with no inversion trick (unlike the ship's dual-buffer
000A6A  2               ; sprite routine, which is what made the ship need flipping) - so this
000A6A  2               ; decodes directly in top-to-bottom order. BBC MODE 2 colors, decoded
000A6A  2               ; carefully via the bit formula this time (pixel0=bits7,5,3,1; pixel1=
000A6A  2               ; bits6,4,2,0) rather than by hand - an earlier pass had this wrong for
000A6A  2               ; the x6 row (called it yellow+magenta; it's actually black+white,
000A6A  2               ; which is exactly the "extra yellow shadow" you flagged - that pixel
000A6A  2               ; should never have been drawn at all): 21($15)=black+white (x6 rows),
000A6A  2               ; 51($33)=magenta+magenta, 1($01)=black+red.
000A6A  2               ; BOMBS1.asm also plots one extra lone pixel in the NEXT column over
000A6A  2               ; (value 34/$22 at Y=14, i.e. that column's row 6, decoding to a lone
000A6A  2               ; magenta dot with black beside it) - that's the 3rd BBC pixel-pair of
000A6A  2               ; row 6, landing in this same C64 cell's other half (position 2 of the
000A6A  2               ; 4 color-pixels a cell holds), so it's included below, not dropped.
000A6A  2               ;
000A6A  2               ; 2 BBC pixels wide on its own (rows 0-5 and row 7), row 6 alone reaching
000A6A  2               ; 3 pixels wide via that extra dot. White isn't one of the 3 available
000A6A  2               ; colors here (yellow/cyan/magenta), so it's substituted with magenta -
000A6A  2               ; the only color reduction, not a shape change: the x6 rows' first
000A6A  2               ; pixel is real background (black), not a substituted color, so it's
000A6A  2               ; just left as background, no pixel drawn there at all.
000A6A  2               ;
000A6A  2               ; A small pool (BULLET_COUNT) replaces the old single-bullet-in-flight
000A6A  2               ; limit. Movement is a full cell-row per tick (matching BOMBS1.asm's own
000A6A  2               ; "SBC #8" - it moves 8 BBC scanlines, i.e. one row, per game frame too),
000A6A  2               ; which is simple: no sub-cell/cell-boundary bookkeeping needed at all,
000A6A  2               ; just a plain row counter and compute_bullet_addr's row*40+col*8 math.
000A6A  2               BULLET_COUNT = 4
000A6A  2               
000A6A  2               bullet_bitmap:
000A6A  2  30 30 30 30   .byte $30,$30,$30,$30,$30,$30,$fc,$20
000A6E  2  30 30 FC 20  
000A72  2               
000A72  2               bullet_active:
000A72  2  xx xx xx xx   .res BULLET_COUNT
000A76  2               bullet_row:
000A76  2  xx xx xx xx   .res BULLET_COUNT
000A7A  2               bullet_col:
000A7A  2  xx xx xx xx   .res BULLET_COUNT
000A7E  2               fire_key_prev:
000A7E  2  00            .byte 0
000A7F  2               
000A7F  2               ; compute_bullet_addr: X = bullet slot index. Sets temp3 (word) = bitmap
000A7F  2               ; address of cell (bullet_row[X], bullet_col[X]) - bitmap only, bullets
000A7F  2               ; need no screen-matrix/color-RAM address (see above).
000A7F  2               compute_bullet_addr:
000A7F  2  A9 00            lda #0
000A81  2  85 rr            sta temp3
000A83  2  85 rr            sta temp3+1
000A85  2  BD 76 0A         lda bullet_row,x
000A88  2  F0 13            beq cba_row_done
000A8A  2  85 rr            sta length              ; length = loop counter (documented scratch,
000A8C  2                                            ; free here - see file header)
000A8C  2               cba_row_loop:
000A8C  2  A5 rr            lda temp3
000A8E  2  18               clc
000A8F  2  69 28            adc #40
000A91  2  85 rr            sta temp3
000A93  2  A5 rr            lda temp3+1
000A95  2  69 00            adc #0
000A97  2  85 rr            sta temp3+1
000A99  2  C6 rr            dec length
000A9B  2  D0 EF            bne cba_row_loop
000A9D  2               cba_row_done:
000A9D  2  A5 rr            lda temp3
000A9F  2  18               clc
000AA0  2  7D 7A 0A         adc bullet_col,x
000AA3  2  85 rr            sta temp3
000AA5  2  A5 rr            lda temp3+1
000AA7  2  69 00            adc #0
000AA9  2  85 rr            sta temp3+1              ; temp3 = row*40 + col (cell index)
000AAB  2  06 rr            asl temp3
000AAD  2  26 rr            rol temp3+1
000AAF  2  06 rr            asl temp3
000AB1  2  26 rr            rol temp3+1
000AB3  2  06 rr            asl temp3
000AB5  2  26 rr            rol temp3+1              ; temp3 = cell index * 8
000AB7  2  A5 rr            lda temp3
000AB9  2  18               clc
000ABA  2  69 00            adc #<$6000
000ABC  2  85 rr            sta temp3
000ABE  2  A5 rr            lda temp3+1
000AC0  2  69 60            adc #>$6000
000AC2  2  85 rr            sta temp3+1
000AC4  2  60               rts
000AC5  2               
000AC5  2               ; draw_bullet_x: X = bullet slot index. XOR-plots bullet_bitmap at that
000AC5  2               ; slot's current cell - also serves as its own erase (calling it twice
000AC5  2               ; at the same position cancels out), same as movestars/move_ship.
000AC5  2               ; Preserves X.
000AC5  2               draw_bullet_x:
000AC5  2  20 7F 0A         jsr compute_bullet_addr
000AC8  2  A0 00            ldy #0
000ACA  2               dbx_loop:
000ACA  2  B9 6A 0A         lda bullet_bitmap,y
000ACD  2  51 rr            eor (temp3),y
000ACF  2  91 rr            sta (temp3),y
000AD1  2  C8               iny
000AD2  2  C0 08            cpy #8
000AD4  2  D0 F4            bne dbx_loop
000AD6  2  60               rts
000AD7  2               
000AD7  2               ; fire_bullet_if_requested: RETURN fires, edge-triggered (only on a
000AD7  2               ; fresh press, not held down) into the first free slot of the pool -
000AD7  2               ; SPACE is reserved for starting the game and is never read here. The
000AD7  2               ; edge trigger is also what stops a bullet firing the instant the game
000AD7  2               ; starts: fire_key_prev is primed with RETURN's actual state right
000AD7  2               ; before game_loop begins (see there), so "still held from starting the
000AD7  2               ; game" doesn't look like a new press.
000AD7  2               fire_bullet_if_requested:
000AD7  2  A9 FE            lda #$FE               ; clear bit0: select column 0 (RETURN's column)
000AD9  2  8D 00 DC         sta $DC00
000ADC  2  AD 01 DC         lda $DC01
000ADF  2  29 02            and #$02                 ; row bit 1 = RETURN
000AE1  2  F0 06            beq fbr_held
000AE3  2  A9 00            lda #0
000AE5  2  8D 7E 0A         sta fire_key_prev
000AE8  2  60               rts
000AE9  2               fbr_held:
000AE9  2  AD 7E 0A         lda fire_key_prev
000AEC  2  D0 33            bne fbr_done             ; already down last frame - not a new press
000AEE  2  A9 01            lda #1
000AF0  2  8D 7E 0A         sta fire_key_prev
000AF3  2               
000AF3  2  A2 00            ldx #0
000AF5  2               fbr_find_slot:
000AF5  2  BD 72 0A         lda bullet_active,x
000AF8  2  F0 06            beq fbr_spawn
000AFA  2  E8               inx
000AFB  2  E0 04            cpx #BULLET_COUNT
000AFD  2  D0 F6            bne fbr_find_slot
000AFF  2  60               rts                      ; pool is full - drop this shot
000B00  2               fbr_spawn:
000B00  2  A9 01            lda #1
000B02  2  9D 72 0A         sta bullet_active,x
000B05  2                   ; Spawn one row ABOVE the ship, never in the ship's own cell: that
000B05  2                   ; cell has the ship's own screen-matrix/color-RAM override (see
000B05  2                   ; SHIP_MATRIX_BYTE), so a bullet XOR'd in there shows the wrong
000B05  2                   ; colors, and worse, erase_ship/draw_ship overwrite it outright
000B05  2                   ; (not XOR) whenever the ship moves, desyncing the bullet's XOR
000B05  2                   ; parity permanently - this was the "stuck single pixel" bug.
000B05  2  AD 68 0A         lda ship_row
000B08  2  F0 06            beq fbr_row_zero
000B0A  2  38               sec
000B0B  2  E9 01            sbc #1
000B0D  2  4C 12 0B         jmp fbr_row_set
000B10  2               fbr_row_zero:
000B10  2  A9 00            lda #0
000B12  2               fbr_row_set:
000B12  2  9D 76 0A         sta bullet_row,x
000B15  2  AD 67 0A         lda ship_col
000B18  2  18               clc
000B19  2  69 01            adc #1                   ; middle of the ship's 3 cells
000B1B  2  9D 7A 0A         sta bullet_col,x
000B1E  2  20 C5 0A         jsr draw_bullet_x
000B21  2               fbr_done:
000B21  2  60               rts
000B22  2               
000B22  2               ; move_bullets: advances every active bullet one cell-row up per call,
000B22  2               ; deactivating instead of wrapping once it passes row 0 (compare
000B22  2               ; movestars, which respawns - bullets just vanish off the top).
000B22  2               ; Throttled the same way as movestars/handle_ship_input - a full cell-
000B22  2               ; row a frame was too fast to actually look at. This slowdown is a
000B22  2               ; temporary look-at-it aid, not a final gameplay speed - revisit once
000B22  2               ; real play-balance is being tuned. Colors (currently substituted white
000B22  2               ; -> magenta, red -> cyan, per the 3-non-black-per-cell budget - see the
000B22  2               ; bullet_bitmap note above) are also accepted "for now", not final -
000B22  2               ; revisit those too when picking the game's real palette.
000B22  2               BULLET_MOVE_SLOWDOWN = 8
000B22  2               bullet_move_count:
000B22  2  00            .byte 0
000B23  2               
000B23  2               move_bullets:
000B23  2  EE 22 0B         inc bullet_move_count
000B26  2  AD 22 0B         lda bullet_move_count
000B29  2  C9 08            cmp #BULLET_MOVE_SLOWDOWN
000B2B  2  90 27            bcc mbs_rts
000B2D  2  A9 00            lda #0
000B2F  2  8D 22 0B         sta bullet_move_count
000B32  2               
000B32  2  A2 00            ldx #0
000B34  2               mbs_loop:
000B34  2  BD 72 0A         lda bullet_active,x
000B37  2  F0 16            beq mbs_next
000B39  2  20 C5 0A         jsr draw_bullet_x         ; erase at the current position
000B3C  2  BD 76 0A         lda bullet_row,x
000B3F  2  F0 09            beq mbs_deactivate
000B41  2  DE 76 0A         dec bullet_row,x
000B44  2  20 C5 0A         jsr draw_bullet_x         ; redraw at the new position
000B47  2  4C 4F 0B         jmp mbs_next
000B4A  2               mbs_deactivate:
000B4A  2  A9 00            lda #0
000B4C  2  9D 72 0A         sta bullet_active,x
000B4F  2               mbs_next:
000B4F  2  E8               inx
000B50  2  E0 04            cpx #BULLET_COUNT
000B52  2  D0 E0            bne mbs_loop
000B54  2               mbs_rts:
000B54  2  60               rts
000B55  2               
000B55  2               ; --- Alien (test render, fixed position - "let's put an alien on the
000B55  2               ; screen so we can take a look"): decoded from O.GRAPHIC's graphics
000B55  2               ; pointer table, entry 6 (BBC address $2BE0, file offset $2BE0-$297A=
000B55  2               ; 1638). ALIENS2.asm's alien_on_off reaches this table via "LDA graph,X:
000B55  2               ; LDY graph+1,X", X = an alien's initgra value - a byte offset into the
000B55  2               ; SAME pointer table the ship's graph+36/37 pointer lives in (see
000B55  2               ; ship_bitmap below): entries are 96 bytes apart (alwidth*alheight=6*16,
000B55  2               ; CONST.asm), dumping the table's first 19 entries shows 0x29a0, 0x2a00,
000B55  2               ; 0x2a60, 0x2ac0, ... up to entry 18 = 0x2fa0, exactly the ship's known
000B55  2               ; pointer - confirming the table layout. Same dual-buffer "sprite"
000B55  2               ; plotter as the ship, so the same row-reversal applies. Colors (blue 59
000B55  2               ; px, cyan 38, white 13, plus 2 stray magenta pixels folded into blue)
000B55  2               ; fit the 3-non-black-per-cell budget with almost no loss - unlike the
000B55  2               ; ship, nothing major needed substituting away.
000B55  2               ALIEN_ROW = 10
000B55  2               ALIEN_COL = 18
000B55  2               ALIEN_MATRIX_BYTE   = $63   ; hi-nibble=6 (blue, pattern 01), lo-nibble=3 (cyan, pattern 10)
000B55  2               ALIEN_COLORRAM_BYTE = $01   ; white (pattern 11)
000B55  2               
000B55  2               alien_bitmap:
000B55  2  00 03 0F 0D   .byte $00,$03,$0f,$0d,$25,$25,$09,$02
000B59  2  25 25 09 02  
000B5D  2  20 EF FF 55   .byte $20,$ef,$ff,$55,$55,$55,$55,$56
000B61  2  55 55 55 56  
000B65  2  00 00 C0 C0   .byte $00,$00,$c0,$c0,$60,$60,$80,$00
000B69  2  60 60 80 00  
000B6D  2  29 95 99 22   .byte $29,$95,$99,$22,$02,$09,$25,$0a
000B71  2  02 09 25 0A  
000B75  2  55 55 55 56   .byte $55,$55,$55,$56,$66,$65,$89,$02
000B79  2  66 65 89 02  
000B7D  2  A0 58 98 20   .byte $a0,$58,$98,$20,$00,$80,$60,$80
000B81  2  00 80 60 80  
000B85  2               
000B85  2               ; draw_alien: fixed position (compile-time constants, no movement yet -
000B85  2               ; this is just a test render), so plain absolute,Y addressing works
000B85  2               ; directly, no runtime address computation needed.
000B85  2               draw_alien:
000B85  2  A2 00            ldx #0
000B87  2  A0 00            ldy #0
000B89  2               dal_top:
000B89  2  BD 55 0B         lda alien_bitmap,x
000B8C  2  99 10 6D         sta $6000+(ALIEN_ROW*40+ALIEN_COL)*8,y
000B8F  2  E8               inx
000B90  2  C8               iny
000B91  2  C0 18            cpy #24
000B93  2  D0 F4            bne dal_top
000B95  2               
000B95  2  A0 00            ldy #0
000B97  2               dal_bottom:
000B97  2  BD 55 0B         lda alien_bitmap,x
000B9A  2  99 50 6E         sta $6000+((ALIEN_ROW+1)*40+ALIEN_COL)*8,y
000B9D  2  E8               inx
000B9E  2  C8               iny
000B9F  2  C0 18            cpy #24
000BA1  2  D0 F4            bne dal_bottom
000BA3  2               
000BA3  2  A9 63            lda #ALIEN_MATRIX_BYTE
000BA5  2  8D A2 41         sta $4000+ALIEN_ROW*40+ALIEN_COL+0
000BA8  2  8D A3 41         sta $4000+ALIEN_ROW*40+ALIEN_COL+1
000BAB  2  8D A4 41         sta $4000+ALIEN_ROW*40+ALIEN_COL+2
000BAE  2  8D CA 41         sta $4000+(ALIEN_ROW+1)*40+ALIEN_COL+0
000BB1  2  8D CB 41         sta $4000+(ALIEN_ROW+1)*40+ALIEN_COL+1
000BB4  2  8D CC 41         sta $4000+(ALIEN_ROW+1)*40+ALIEN_COL+2
000BB7  2               
000BB7  2  A9 01            lda #ALIEN_COLORRAM_BYTE
000BB9  2  8D A2 D9         sta $D800+ALIEN_ROW*40+ALIEN_COL+0
000BBC  2  8D A3 D9         sta $D800+ALIEN_ROW*40+ALIEN_COL+1
000BBF  2  8D A4 D9         sta $D800+ALIEN_ROW*40+ALIEN_COL+2
000BC2  2  8D CA D9         sta $D800+(ALIEN_ROW+1)*40+ALIEN_COL+0
000BC5  2  8D CB D9         sta $D800+(ALIEN_ROW+1)*40+ALIEN_COL+1
000BC8  2  8D CC D9         sta $D800+(ALIEN_ROW+1)*40+ALIEN_COL+2
000BCB  2  60               rts
000BCC  2               
000BCC  2               ; --- The player ship: decoded directly from the BBC object file, not
000BCC  2               ; guessed or sampled from a screenshot. FLAGS.asm's INIT.asm calls
000BCC  2               ; JSR sprite with a pointer taken from graph+36/37 (graph = &297A, the
000BCC  2               ; load address of object/O.GRAPHIC - see CONST.asm); that pointer is
000BCC  2               ; $2FA0, i.e. file offset $2FA0-$297A = 1574, and CONST.asm's mywidth=6/
000BCC  2               ; myheight=16 give its size: 6 BBC bytes (12 BBC pixels) wide by 16
000BCC  2               ; scanlines tall - exactly a 3-cell by 2-cell block at native width
000BCC  2               ; (1 BBC pixel = 1 C64 color-pixel, the same equivalence used for the
000BCC  2               ; text and flags - see the file header).
000BCC  2               ;
000BCC  2               ; The real ship uses all 8 BBC MODE 2 colors; reduced here to white/
000BCC  2               ; yellow/cyan + black (the 3-non-black-per-cell limit - same tradeoff as
000BCC  2               ; the star field). Frequency in the real data (black 89, yellow 37,
000BCC  2               ; white 36, cyan 15, green 8, magenta 3, blue 2, red 2 pixels) picked
000BCC  2               ; the keepers: white and yellow stay as-is (by far the two biggest
000BCC  2               ; blocks - hull outline and hull fill), green folds into white (mostly
000BCC  2               ; adjacent to it, the wingtip outline), and cyan absorbs blue/magenta/
000BCC  2               ; red (all minor engine/thruster accents already inside the cyan engine
000BCC  2               ; block). ship_bitmap is 6 cells' worth of C64 multicolor bytes, top row
000BCC  2               ; (cols 0-2) then bottom row (cols 0-2), 8 bytes/cell, matching how
000BCC  2               ; compute_ship_addrs/draw_ship walk it.
000BCC  2               SHIP_START_ROW  = 20
000BCC  2               SHIP_START_COL  = 18
000BCC  2               SHIP_MIN_COL    = 0
000BCC  2               SHIP_MAX_COL    = 37     ; 40 cells - 3 wide
000BCC  2               SHIP_MIN_ROW    = 0
000BCC  2               SHIP_MAX_ROW    = 23     ; 25 rows - 2 tall
000BCC  2               SHIP_MATRIX_BYTE   = $17 ; hi-nibble=1 (white, pattern 01), lo-nibble=7 (yellow, pattern 10)
000BCC  2               SHIP_COLORRAM_BYTE = $03 ; cyan (pattern 11)
000BCC  2               
000BCC  2               ; Rows run bottom-to-top in the source data (the BBC plotter counts the
000BCC  2               ; screen address DOWN as it walks forward through the bytes), so this is
000BCC  2               ; the decoded data with row order reversed from the first pass - that
000BCC  2               ; first pass had the engine/exhaust end on top and the nose on the
000BCC  2               ; bottom, i.e. upside down.
000BCC  2               ship_bitmap:
000BCC  2  00 00 00 03   .byte $00,$00,$00,$03,$01,$01,$02,$c2
000BD0  2  01 01 02 C2  
000BD4  2  30 10 10 13   .byte $30,$10,$10,$13,$65,$a9,$ba,$fe
000BD8  2  65 A9 BA FE  
000BDC  2  00 00 00 00   .byte $00,$00,$00,$00,$00,$00,$00,$0c
000BE0  2  00 00 00 0C  
000BE4  2  4A 69 65 61   .byte $4a,$69,$65,$61,$69,$66,$91,$40
000BE8  2  69 66 91 40  
000BEC  2  FE FD FD FD   .byte $fe,$fd,$fd,$fd,$75,$56,$a9,$88
000BF0  2  75 56 A9 88  
000BF4  2  84 A4 64 24   .byte $84,$a4,$64,$24,$a4,$64,$18,$04
000BF8  2  A4 64 18 04  
000BFC  2               
000BFC  2               ; compute_ship_addrs: A = leftmost column (0-39) of the ship's 3-cell
000BFC  2               ; span; ship_row (0-24) = its top row. Sets temp3 (word) = bitmap
000BFC  2               ; address of cell (ship_row, col), temp4 (word) = screen-matrix address
000BFC  2               ; of that cell, temp2 (word) = the matching color-RAM address. Row is
000BFC  2               ; now a variable (up/down movement), so this needs one runtime multiply
000BFC  2               ; (ship_row*40, via repeated add - ship_row is at most 24, and this only
000BFC  2               ; runs on an actual move-tick, not every frame) - everything else is
000BFC  2               ; derived from that same (ship_row*40+col) cell index by shifting (*8
000BFC  2               ; for the bitmap byte offset) or adding a base page.
000BFC  2               compute_ship_addrs:
000BFC  2  85 rr            sta temp1              ; temp1 = col (see file header on temp1/temp/
000BFE  2                                           ; colour aliasing - free here)
000BFE  2               
000BFE  2  A9 00            lda #0
000C00  2  85 rr            sta temp4
000C02  2  85 rr            sta temp4+1
000C04  2  AD 68 0A         lda ship_row
000C07  2  F0 13            beq csa_row40_done
000C09  2  85 rr            sta length              ; length = loop counter (documented scratch,
000C0B  2                                            ; free here - see file header)
000C0B  2               csa_row40_loop:
000C0B  2  A5 rr            lda temp4
000C0D  2  18               clc
000C0E  2  69 28            adc #40
000C10  2  85 rr            sta temp4
000C12  2  A5 rr            lda temp4+1
000C14  2  69 00            adc #0
000C16  2  85 rr            sta temp4+1
000C18  2  C6 rr            dec length
000C1A  2  D0 EF            bne csa_row40_loop
000C1C  2               csa_row40_done:
000C1C  2  A5 rr            lda temp4
000C1E  2  18               clc
000C1F  2  65 rr            adc temp1
000C21  2  85 rr            sta temp4
000C23  2  A5 rr            lda temp4+1
000C25  2  69 00            adc #0
000C27  2  85 rr            sta temp4+1              ; temp4 = ship_row*40 + col (no page base yet)
000C29  2               
000C29  2  A5 rr            lda temp4
000C2B  2  85 rr            sta temp3
000C2D  2  A5 rr            lda temp4+1
000C2F  2  85 rr            sta temp3+1
000C31  2  06 rr            asl temp3
000C33  2  26 rr            rol temp3+1
000C35  2  06 rr            asl temp3
000C37  2  26 rr            rol temp3+1
000C39  2  06 rr            asl temp3
000C3B  2  26 rr            rol temp3+1              ; temp3 = (ship_row*40+col) * 8
000C3D  2  A5 rr            lda temp3
000C3F  2  18               clc
000C40  2  69 00            adc #<$6000
000C42  2  85 rr            sta temp3
000C44  2  A5 rr            lda temp3+1
000C46  2  69 60            adc #>$6000
000C48  2  85 rr            sta temp3+1              ; temp3 = bitmap address
000C4A  2               
000C4A  2  A5 rr            lda temp4
000C4C  2  18               clc
000C4D  2  69 00            adc #<$D800
000C4F  2  85 rr            sta temp2
000C51  2  A5 rr            lda temp4+1
000C53  2  69 D8            adc #>$D800
000C55  2  85 rr            sta temp2+1              ; temp2 = color-RAM address
000C57  2               
000C57  2  A5 rr            lda temp4
000C59  2  18               clc
000C5A  2  69 00            adc #<$4000
000C5C  2  85 rr            sta temp4
000C5E  2  A5 rr            lda temp4+1
000C60  2  69 40            adc #>$4000
000C62  2  85 rr            sta temp4+1              ; temp4 = screen-matrix address
000C64  2  60               rts
000C65  2               
000C65  2               ; draw_ship: draws the ship at column ship_col. The 6 cells' worth of
000C65  2               ; bitmap bytes are contiguous per row (temp3+0..23 covers all 3 top-row
000C65  2               ; cells, since adjacent C64 cells in a row sit back to back in memory),
000C65  2               ; so this is just two 24-byte linear copies rather than 6 separate
000C65  2               ; per-cell loops.
000C65  2               draw_ship:
000C65  2  AD 67 0A         lda ship_col
000C68  2  20 FC 0B         jsr compute_ship_addrs
000C6B  2               
000C6B  2  A2 00            ldx #0
000C6D  2  A0 00            ldy #0
000C6F  2               dsh_top:
000C6F  2  BD CC 0B         lda ship_bitmap,x
000C72  2  91 rr            sta (temp3),y
000C74  2  E8               inx
000C75  2  C8               iny
000C76  2  C0 18            cpy #24
000C78  2  D0 F5            bne dsh_top
000C7A  2               
000C7A  2  A5 rr            lda temp3
000C7C  2  18               clc
000C7D  2  69 40            adc #<320
000C7F  2  85 rr            sta temp3
000C81  2  A5 rr            lda temp3+1
000C83  2  69 01            adc #>320
000C85  2  85 rr            sta temp3+1
000C87  2               
000C87  2  A0 00            ldy #0
000C89  2               dsh_bottom:
000C89  2  BD CC 0B         lda ship_bitmap,x
000C8C  2  91 rr            sta (temp3),y
000C8E  2  E8               inx
000C8F  2  C8               iny
000C90  2  C0 18            cpy #24
000C92  2  D0 F5            bne dsh_bottom
000C94  2               
000C94  2  A9 17            lda #SHIP_MATRIX_BYTE
000C96  2  A0 00            ldy #0
000C98  2  91 rr            sta (temp4),y
000C9A  2  A0 01            ldy #1
000C9C  2  91 rr            sta (temp4),y
000C9E  2  A0 02            ldy #2
000CA0  2  91 rr            sta (temp4),y
000CA2  2  A0 28            ldy #40
000CA4  2  91 rr            sta (temp4),y
000CA6  2  A0 29            ldy #41
000CA8  2  91 rr            sta (temp4),y
000CAA  2  A0 2A            ldy #42
000CAC  2  91 rr            sta (temp4),y
000CAE  2               
000CAE  2  A9 03            lda #SHIP_COLORRAM_BYTE
000CB0  2  A0 00            ldy #0
000CB2  2  91 rr            sta (temp2),y
000CB4  2  A0 01            ldy #1
000CB6  2  91 rr            sta (temp2),y
000CB8  2  A0 02            ldy #2
000CBA  2  91 rr            sta (temp2),y
000CBC  2  A0 28            ldy #40
000CBE  2  91 rr            sta (temp2),y
000CC0  2  A0 29            ldy #41
000CC2  2  91 rr            sta (temp2),y
000CC4  2  A0 2A            ldy #42
000CC6  2  91 rr            sta (temp2),y
000CC8  2  60               rts
000CC9  2               
000CC9  2               ; erase_ship: blanks the ship's current 6 cells back to plain star-field
000CC9  2               ; background (bitmap 0, screen-matrix/color-RAM back to clear_screen's
000CC9  2               ; defaults) - any star that happened to be under the ship is lost rather
000CC9  2               ; than composited back in, an accepted simplification for this pass.
000CC9  2               erase_ship:
000CC9  2  AD 67 0A         lda ship_col
000CCC  2  20 FC 0B         jsr compute_ship_addrs
000CCF  2               
000CCF  2  A9 00            lda #0
000CD1  2  A0 00            ldy #0
000CD3  2               esh_top:
000CD3  2  91 rr            sta (temp3),y
000CD5  2  C8               iny
000CD6  2  C0 18            cpy #24
000CD8  2  D0 F9            bne esh_top
000CDA  2               
000CDA  2  A5 rr            lda temp3
000CDC  2  18               clc
000CDD  2  69 40            adc #<320
000CDF  2  85 rr            sta temp3
000CE1  2  A5 rr            lda temp3+1
000CE3  2  69 01            adc #>320
000CE5  2  85 rr            sta temp3+1
000CE7  2               
000CE7  2  A9 00            lda #0
000CE9  2  A0 00            ldy #0
000CEB  2               esh_bottom:
000CEB  2  91 rr            sta (temp3),y
000CED  2  C8               iny
000CEE  2  C0 18            cpy #24
000CF0  2  D0 F9            bne esh_bottom
000CF2  2               
000CF2  2  A9 73            lda #$73
000CF4  2  A0 00            ldy #0
000CF6  2  91 rr            sta (temp4),y
000CF8  2  A0 01            ldy #1
000CFA  2  91 rr            sta (temp4),y
000CFC  2  A0 02            ldy #2
000CFE  2  91 rr            sta (temp4),y
000D00  2  A0 28            ldy #40
000D02  2  91 rr            sta (temp4),y
000D04  2  A0 29            ldy #41
000D06  2  91 rr            sta (temp4),y
000D08  2  A0 2A            ldy #42
000D0A  2  91 rr            sta (temp4),y
000D0C  2               
000D0C  2  A9 04            lda #4
000D0E  2  A0 00            ldy #0
000D10  2  91 rr            sta (temp2),y
000D12  2  A0 01            ldy #1
000D14  2  91 rr            sta (temp2),y
000D16  2  A0 02            ldy #2
000D18  2  91 rr            sta (temp2),y
000D1A  2  A0 28            ldy #40
000D1C  2  91 rr            sta (temp2),y
000D1E  2  A0 29            ldy #41
000D20  2  91 rr            sta (temp2),y
000D22  2  A0 2A            ldy #42
000D24  2  91 rr            sta (temp2),y
000D26  2  60               rts
000D27  2               
000D27  2               ; clear_screen: blanks the bitmap and resets screen-matrix/color RAM to
000D27  2               ; the star field's 3 background colors (see STARS.asm) - shared by the
000D27  2               ; boot-time title setup and by the transition into the game, since both
000D27  2               ; need to start from the same blank state.
000D27  2               clear_screen:
000D27  2                   ; Clear the full bitmap (8000 bytes, 32 pages - a little more than
000D27  2                   ; needed, $6000-$7FFF is exactly 8K).
000D27  2  A9 00            lda #<$6000
000D29  2  85 rr            sta temp2
000D2B  2  A9 60            lda #>$6000
000D2D  2  85 rr            sta temp2+1
000D2F  2  A2 20            ldx #32
000D31  2  A9 00            lda #0
000D33  2               clear_bitmap_page:
000D33  2  A0 00            ldy #0
000D35  2               clear_bitmap_byte:
000D35  2  91 rr            sta (temp2),y
000D37  2  C8               iny
000D38  2  D0 FB            bne clear_bitmap_byte
000D3A  2  E6 rr            inc temp2+1
000D3C  2  CA               dex
000D3D  2  D0 F4            bne clear_bitmap_page
000D3F  2               
000D3F  2                   ; Screen-matrix (1000 bytes, rounded up to 4 pages): default
000D3F  2                   ; background cell hi-nibble=7 (yellow), lo-nibble=3 (cyan) - 2 of the
000D3F  2                   ; moving star field's 3 colors; the 3rd (color RAM low-nibble) is set
000D3F  2                   ; below.
000D3F  2  A9 00            lda #<$4000
000D41  2  85 rr            sta temp2
000D43  2  A9 40            lda #>$4000
000D45  2  85 rr            sta temp2+1
000D47  2  A2 04            ldx #4
000D49  2  A9 73            lda #$73
000D4B  2               clear_screenmatrix_page:
000D4B  2  A0 00            ldy #0
000D4D  2               clear_screenmatrix_byte:
000D4D  2  91 rr            sta (temp2),y
000D4F  2  C8               iny
000D50  2  D0 FB            bne clear_screenmatrix_byte
000D52  2  E6 rr            inc temp2+1
000D54  2  CA               dex
000D55  2  D0 F4            bne clear_screenmatrix_page
000D57  2               
000D57  2  A9 00            lda #<$D800
000D59  2  85 rr            sta temp2
000D5B  2  A9 D8            lda #>$D800
000D5D  2  85 rr            sta temp2+1
000D5F  2  A2 04            ldx #4
000D61  2  A9 04            lda #4                ; magenta/purple - the star field's 3rd color
000D63  2                                       ; (C64 color 5 is green, not magenta - that was a
000D63  2                                       ; mix-up with the BBC's own palette numbering)
000D63  2               clear_colorram_page:
000D63  2  A0 00            ldy #0
000D65  2               clear_colorram_byte:
000D65  2  91 rr            sta (temp2),y
000D67  2  C8               iny
000D68  2  D0 FB            bne clear_colorram_byte
000D6A  2  E6 rr            inc temp2+1
000D6C  2  CA               dex
000D6D  2  D0 F4            bne clear_colorram_page
000D6F  2  60               rts
000D70  2               
000D70  2               ; ROUT3.asm references this during the unfinished game path.
000D70  2               process_demo:
000D70  2  60               rts
000D71  2               
000D71  2               ; --- Level-number flags, bottom-left corner (rows 23-24) - NOT a lives
000D71  2               ; display (that's the separate icon below, bottom-right): FLAGS.asm's
000D71  2               ; flagson draws this from `temp` = curwave+1, i.e. the wave/level number,
000D71  2               ; broken into batches of 10, then 5, then however many 1s are left over
000D71  2               ; (see flagson's flag0/flag1/flag2 dispatch, which picks flaggra block
000D71  2               ; 0/27/54 accordingly) - like a tally, not a fixed "3 lives" icon set.
000D71  2               ; flaggra holds all 3 variants (27 bytes each): block 1 (X=0, "x10"),
000D71  2               ; block 2 (X=27, "x5"), block 3 (X=54, "x1" - the one decoded and drawn
000D71  2               ; here). Decoded from the REAL BBC source, not sampled from a screenshot
000D71  2               ; (addres/addres1 640 bytes apart = one MODE 2 character row, confirmed
000D71  2               ; against the Advanced User Guide's Appendix F memory map; flagson's Y
000D71  2               ; indices address 4 consecutive 2-pixel-wide byte-columns within that
000D71  2               ; row, each byte decoded with the confirmed bit format):
000D71  2               ;   . R . . . . . .   (R=red pole, M=magenta body, B=blue stripe)
000D71  2               ;   . R M . . . . .
000D71  2               ;   . R M M . . . .
000D71  2               ;   . R M B M . . .
000D71  2               ;   . R M B M M . .
000D71  2               ;   . R M B M M M .
000D71  2               ;   . R M B M M . .
000D71  2               ;   . R M B M . . .
000D71  2               ;   . R M M . . . .
000D71  2               ;   . R M . . . . .
000D71  2               ;   . R . . . . . .   (x6 rows - bare pole)
000D71  2               ; This game has no wave/level advancement yet (no aliens, no scoring),
000D71  2               ; so level_ones is just a fixed placeholder for now and the x10/x5
000D71  2               ; batch icons - needed once a level can reach 10 - aren't decoded yet;
000D71  2               ; nothing here can exercise them until that exists.
000D71  2               level_ones:
000D71  2  01            .byte 1
000D72  2               
000D72  2               ; draw_level_flags: draws level_ones (0-9) individual "x1" flags side by
000D72  2               ; side from the left edge (cols 0,2,4,...), 2 cells each.
000D72  2               draw_level_flags:
000D72  2  AD 71 0D         lda level_ones
000D75  2  F0 17            beq dlf_done
000D77  2  85 rr            sta length              ; length = remaining count (scratch)
000D79  2  A9 00            lda #0
000D7B  2  85 rr            sta temp1                ; temp1 = flag index (scratch) - see the
000D7D  2                                             ; save/restore below; draw_one_flag also
000D7D  2                                             ; uses temp1, for its own purpose (column)
000D7D  2               dlf_loop:
000D7D  2  A5 rr            lda temp1
000D7F  2  48               pha
000D80  2  0A               asl a
000D81  2  20 8F 0D         jsr draw_one_flag
000D84  2  68               pla
000D85  2  18               clc
000D86  2  69 01            adc #1
000D88  2  85 rr            sta temp1
000D8A  2  C6 rr            dec length
000D8C  2  D0 EF            bne dlf_loop
000D8E  2               dlf_done:
000D8E  2  60               rts
000D8F  2               
000D8F  2               ; draw_one_flag: A = starting column of a 2-cell-wide "x1" flag at the
000D8F  2               ; fixed rows 23-24 (col*8 done as a single byte add - safe since callers
000D8F  2               ; only ever pass small columns, well under 32).
000D8F  2               draw_one_flag:
000D8F  2  85 rr            sta temp1
000D91  2               
000D91  2                   ; bitmap: compute the top-left cell's address once; the other 3
000D91  2                   ; cells are fixed byte offsets from it (+8 = one cell right, +320 =
000D91  2                   ; one row down), not each independently recomputed from col*8.
000D91  2  A5 rr            lda temp1
000D93  2  0A               asl a
000D94  2  0A               asl a
000D95  2  0A               asl a
000D96  2  18               clc
000D97  2  69 C0            adc #<($6000+23*40*8)
000D99  2  85 rr            sta temp3
000D9B  2  A9 00            lda #0
000D9D  2  69 7C            adc #>($6000+23*40*8)
000D9F  2  85 rr            sta temp3+1
000DA1  2  A0 00            ldy #0
000DA3  2               dof_tl:
000DA3  2  B9 8C 0F         lda flag_top_left,y
000DA6  2  91 rr            sta (temp3),y
000DA8  2  C8               iny
000DA9  2  C0 08            cpy #8
000DAB  2  D0 F6            bne dof_tl
000DAD  2               
000DAD  2  A5 rr            lda temp3
000DAF  2  18               clc
000DB0  2  69 08            adc #8
000DB2  2  85 rr            sta temp3
000DB4  2  A5 rr            lda temp3+1
000DB6  2  69 00            adc #0
000DB8  2  85 rr            sta temp3+1
000DBA  2  A0 00            ldy #0
000DBC  2               dof_tr:
000DBC  2  B9 94 0F         lda flag_top_right,y
000DBF  2  91 rr            sta (temp3),y
000DC1  2  C8               iny
000DC2  2  C0 08            cpy #8
000DC4  2  D0 F6            bne dof_tr
000DC6  2               
000DC6  2  A5 rr            lda temp3
000DC8  2  18               clc
000DC9  2  69 38            adc #<(320-8)
000DCB  2  85 rr            sta temp3
000DCD  2  A5 rr            lda temp3+1
000DCF  2  69 01            adc #>(320-8)
000DD1  2  85 rr            sta temp3+1
000DD3  2  A0 00            ldy #0
000DD5  2               dof_bl:
000DD5  2  B9 9C 0F         lda flag_bottom_left,y
000DD8  2  91 rr            sta (temp3),y
000DDA  2  C8               iny
000DDB  2  C0 08            cpy #8
000DDD  2  D0 F6            bne dof_bl
000DDF  2               
000DDF  2  A5 rr            lda temp3
000DE1  2  18               clc
000DE2  2  69 08            adc #8
000DE4  2  85 rr            sta temp3
000DE6  2  A5 rr            lda temp3+1
000DE8  2  69 00            adc #0
000DEA  2  85 rr            sta temp3+1
000DEC  2  A0 00            ldy #0
000DEE  2               dof_br:
000DEE  2  B9 A4 0F         lda flag_bottom_right,y
000DF1  2  91 rr            sta (temp3),y
000DF3  2  C8               iny
000DF4  2  C0 08            cpy #8
000DF6  2  D0 F6            bne dof_br
000DF8  2               
000DF8  2                   ; screen-matrix: same idea - one base (+col, no *8 needed, 1 byte/
000DF8  2                   ; cell), then +1/+40/+41 for the other 3 cells.
000DF8  2  A5 rr            lda temp1
000DFA  2  18               clc
000DFB  2  69 98            adc #<($4000+23*40)
000DFD  2  85 rr            sta temp4
000DFF  2  A9 00            lda #0
000E01  2  69 43            adc #>($4000+23*40)
000E03  2  85 rr            sta temp4+1
000E05  2               
000E05  2  A9 42            lda #$42
000E07  2  A0 00            ldy #0
000E09  2  91 rr            sta (temp4),y
000E0B  2  A9 64            lda #$64
000E0D  2  A0 01            ldy #1
000E0F  2  91 rr            sta (temp4),y
000E11  2  A9 42            lda #$42
000E13  2  A0 28            ldy #40
000E15  2  91 rr            sta (temp4),y
000E17  2  A9 04            lda #$04
000E19  2  A0 29            ldy #41
000E1B  2  91 rr            sta (temp4),y
000E1D  2               
000E1D  2                   ; color-RAM: only the top-left cell ever draws a "11" pixel pattern,
000E1D  2                   ; so it's the only one that needs its color-RAM byte set.
000E1D  2  A5 rr            lda temp1
000E1F  2  18               clc
000E20  2  69 98            adc #<($D800+23*40)
000E22  2  85 rr            sta temp2
000E24  2  A9 00            lda #0
000E26  2  69 DB            adc #>($D800+23*40)
000E28  2  85 rr            sta temp2+1
000E2A  2  A9 06            lda #6
000E2C  2  A0 00            ldy #0
000E2E  2  91 rr            sta (temp2),y
000E30  2  60               rts
000E31  2               
000E31  2               ; --- Lives icon, bottom-right corner - decoded from FLAGS.asm's
000E31  2               ; shipgra/liveson, NOT the flags above (those are the level number - see
000E31  2               ; above) and not the main ship graphic either (that's a different, much
000E31  2               ; bigger block - see ship_bitmap). liveson plots shipgra (29 bytes,
000E31  2               ; single buffer - only 1 cell-row tall, unlike the 2-row flag) directly:
000E31  2               ; "LDY#28 / LDA shipgra,Y:EOR(addres),Y:STA(addres),Y:DEY:BPL" - Y
000E31  2               ; indexes shipgra AND the target offset identically, so (unlike the main
000E31  2               ; ship's dual-buffer sprite routine) there's no inversion trick here and
000E31  2               ; this decodes in direct, non-flipped order. 4 BBC byte-columns (Y0-7,
000E31  2               ; 8-15, 16-23, 24-31, the last only 5 bytes long - untouched scanlines
000E31  2               ; default to background) = 2 C64 cells wide, 1 tall. Reduces to the same
000E31  2               ; white/yellow/cyan palette the main ship uses (its own top color
000E31  2               ; frequencies - white 11, cyan 9, yellow 7 - happen to match exactly),
000E31  2               ; so it reuses SHIP_MATRIX_BYTE/SHIP_COLORRAM_BYTE rather than defining
000E31  2               ; its own. liveson draws these right-to-left (addres -= 32 per icon, one
000E31  2               ; per remaining life) - matched here by stepping the column left by 2
000E31  2               ; each time, starting from the right edge.
000E31  2               ;
000E31  2               ; Least certain of the graphics decoded this session: liveson is the
000E31  2               ; only single-buffer (not dual-buffer, not the simple direct one-column
000E31  2               ; plot bombgra uses) routine of the three, so if this doesn't look right
000E31  2               ; in VICE, the buffer/scanline convention here is the first thing to
000E31  2               ; re-check.
000E31  2               LIVES_ROW = 23
000E31  2               LIVES_RIGHT_COL = 38
000E31  2               
000E31  2               lives_count:
000E31  2  03            .byte 3
000E32  2               
000E32  2               ; Tip-on-top, position confirmed correct, kept - just the tip's own 3
000E32  2               ; rows internally reversed (the wide foot was at the very top with the
000E32  2               ; narrow stem below it, backwards; now the stem tapers away from the
000E32  2               ; body at the top and the foot sits against the body, same 3 rows, same
000E32  2               ; place, just reordered).
000E32  2               lives_bitmap_left:
000E32  2  03 01 0B 48   .byte $03,$01,$0b,$48,$5a,$5f,$5f,$cf
000E36  2  5A 5F 5F CF  
000E3A  2               lives_bitmap_right:
000E3A  2  00 00 80 84   .byte $00,$00,$80,$84,$94,$d4,$d4,$cc
000E3E  2  94 D4 D4 CC  
000E42  2               
000E42  2               ; draw_lives_icons: draws lives_count (0-8ish) icons right to left from
000E42  2               ; LIVES_RIGHT_COL, 2 cells apart.
000E42  2               draw_lives_icons:
000E42  2  AD 31 0E         lda lives_count
000E45  2  F0 16            beq dli_done
000E47  2  85 rr            sta length              ; length = remaining count (scratch)
000E49  2  A9 26            lda #LIVES_RIGHT_COL
000E4B  2  85 rr            sta temp1                ; temp1 = column (scratch) - draw_one_lifeicon
000E4D  2                                             ; also uses temp1; save/restore across the call
000E4D  2               dli_loop:
000E4D  2  A5 rr            lda temp1
000E4F  2  48               pha
000E50  2  20 5E 0E         jsr draw_one_lifeicon
000E53  2  68               pla
000E54  2  38               sec
000E55  2  E9 02            sbc #2
000E57  2  85 rr            sta temp1
000E59  2  C6 rr            dec length
000E5B  2  D0 F0            bne dli_loop
000E5D  2               dli_done:
000E5D  2  60               rts
000E5E  2               
000E5E  2               ; draw_one_lifeicon: A = starting column of a 2-cell-wide life icon at
000E5E  2               ; the fixed LIVES_ROW.
000E5E  2               draw_one_lifeicon:
000E5E  2  85 rr            sta temp1
000E60  2               
000E60  2                   ; col*8 as a proper 16-bit value - unlike draw_one_flag (col capped
000E60  2                   ; at 16, safe as a single byte), this is called with columns up to
000E60  2                   ; LIVES_RIGHT_COL=38, and 38*8=304 overflows a byte: the single-byte
000E60  2                   ; version silently dropped the carry, which is why the icons were
000E60  2                   ; landing at the wrong address entirely (not just off by a bit).
000E60  2  A5 rr            lda temp1
000E62  2  85 rr            sta temp3
000E64  2  A9 00            lda #0
000E66  2  85 rr            sta temp3+1
000E68  2  06 rr            asl temp3
000E6A  2  26 rr            rol temp3+1
000E6C  2  06 rr            asl temp3
000E6E  2  26 rr            rol temp3+1
000E70  2  06 rr            asl temp3
000E72  2  26 rr            rol temp3+1              ; temp3(word) = col * 8
000E74  2  A5 rr            lda temp3
000E76  2  18               clc
000E77  2  69 C0            adc #<($6000+LIVES_ROW*40*8)
000E79  2  85 rr            sta temp3
000E7B  2  A5 rr            lda temp3+1
000E7D  2  69 7C            adc #>($6000+LIVES_ROW*40*8)
000E7F  2  85 rr            sta temp3+1
000E81  2  A0 00            ldy #0
000E83  2               dol_left:
000E83  2  B9 32 0E         lda lives_bitmap_left,y
000E86  2  91 rr            sta (temp3),y
000E88  2  C8               iny
000E89  2  C0 08            cpy #8
000E8B  2  D0 F6            bne dol_left
000E8D  2               
000E8D  2                   ; right cell is exactly 8 bytes after the left cell - temp3 is
000E8D  2                   ; already a correct full word here, so this add can't overflow the
000E8D  2                   ; way the from-scratch column computation did above.
000E8D  2  A5 rr            lda temp3
000E8F  2  18               clc
000E90  2  69 08            adc #8
000E92  2  85 rr            sta temp3
000E94  2  A5 rr            lda temp3+1
000E96  2  69 00            adc #0
000E98  2  85 rr            sta temp3+1
000E9A  2  A0 00            ldy #0
000E9C  2               dol_right:
000E9C  2  B9 3A 0E         lda lives_bitmap_right,y
000E9F  2  91 rr            sta (temp3),y
000EA1  2  C8               iny
000EA2  2  C0 08            cpy #8
000EA4  2  D0 F6            bne dol_right
000EA6  2               
000EA6  2  A5 rr            lda temp1
000EA8  2  18               clc
000EA9  2  69 98            adc #<($4000+LIVES_ROW*40)
000EAB  2  85 rr            sta temp4
000EAD  2  A9 00            lda #0
000EAF  2  69 43            adc #>($4000+LIVES_ROW*40)
000EB1  2  85 rr            sta temp4+1
000EB3  2  A9 17            lda #SHIP_MATRIX_BYTE
000EB5  2  A0 00            ldy #0
000EB7  2  91 rr            sta (temp4),y
000EB9  2  A0 01            ldy #1
000EBB  2  91 rr            sta (temp4),y
000EBD  2               
000EBD  2  A5 rr            lda temp1
000EBF  2  18               clc
000EC0  2  69 98            adc #<($D800+LIVES_ROW*40)
000EC2  2  85 rr            sta temp2
000EC4  2  A9 00            lda #0
000EC6  2  69 DB            adc #>($D800+LIVES_ROW*40)
000EC8  2  85 rr            sta temp2+1
000ECA  2  A9 03            lda #SHIP_COLORRAM_BYTE
000ECC  2  A0 00            ldy #0
000ECE  2  91 rr            sta (temp2),y
000ED0  2  A0 01            ldy #1
000ED2  2  91 rr            sta (temp2),y
000ED4  2  60               rts
000ED5  2               
000ED5  2               ; --- Score bar / body text: both just a list of (string, position,
000ED5  2               ; color) to print with print_bitmap_line, so both are driven off a
000ED5  2               ; small table instead of repeating the same 8-line "set 4 registers,
000ED5  2               ; call" block once per string (10 strings between the two of them).
000ED5  2               ; Positions measured from the reference screenshot directly (col =
000ED5  2               ; pixel_x/4/4 - /4 to reach true color-pixel units per the letter-width
000ED5  2               ; cross-check in print_bitmap_line's history, /4 again for cells), not
000ED5  2               ; carried over from the old per-letter-width assumptions.
000ED5  2               ;
000ED5  2               ; Each table is walked with plain ABSOLUTE,X addressing (X = running
000ED5  2               ; byte offset), not an indirect pointer: (zp),Y addressing needs the
000ED5  2               ; pointer IN zero page, and zero page is already full (see stardat's
000ED5  2               ; note in Master-c64.mak.asm) - a table-name-agnostic shared loop would
000ED5  2               ; need exactly that, so this is 2 small near-identical loops (one per
000ED5  2               ; table) instead of 1 shared one. X doesn't survive the jsr
000ED5  2               ; (print_bitmap_line uses it internally), so it's saved to a plain byte
000ED5  2               ; around the call rather than the stack, just to keep this readable.
000ED5  2               dtt_saved_x:
000ED5  2  00            .byte 0
000ED6  2               
000ED6  2               draw_score_bar:
000ED6  2  A2 00            ldx #0
000ED8  2               dsb_loop:
000ED8  2  BD 46 0F         lda score_bar_table,x
000EDB  2  85 rr            sta temp2
000EDD  2  BD 47 0F         lda score_bar_table+1,x
000EE0  2  85 rr            sta temp2+1
000EE2  2  BD 48 0F         lda score_bar_table+2,x
000EE5  2  85 rr            sta temp3
000EE7  2  BD 49 0F         lda score_bar_table+3,x
000EEA  2  85 rr            sta temp3+1
000EEC  2  BD 4A 0F         lda score_bar_table+4,x
000EEF  2  85 rr            sta temp4
000EF1  2  BD 4B 0F         lda score_bar_table+5,x
000EF4  2  85 rr            sta temp4+1
000EF6  2  BD 4C 0F         lda score_bar_table+6,x
000EF9  2  85 rr            sta colour
000EFB  2  8E D5 0E         stx dtt_saved_x
000EFE  2  20 AC 0F         jsr print_bitmap_line
000F01  2  AE D5 0E         ldx dtt_saved_x
000F04  2  8A               txa
000F05  2  18               clc
000F06  2  69 07            adc #7
000F08  2  AA               tax
000F09  2  E0 1C            cpx #(4*7)
000F0B  2  D0 CB            bne dsb_loop
000F0D  2  60               rts
000F0E  2               
000F0E  2               ; K and S are two separate table entries (two separate strings), not one
000F0E  2               ; "KS" string, so they can have different colors: with the tight sub-
000F0E  2               ; cell spacing, letters within ONE string can share a cell (see
000F0E  2               ; print_bitmap_line), which would force them to the same color. Drawing
000F0E  2               ; them separately, each starting fresh at color-pixel offset 0, keeps
000F0E  2               ; their own spacing unchanged - S just starts 2 cells after K (K's own
000F0E  2               ; span), the minimum gap that avoids sharing a cell, not extra space
000F0E  2               ; added.
000F0E  2               draw_body_text:
000F0E  2  A2 00            ldx #0
000F10  2               dbt_loop:
000F10  2  BD 62 0F         lda body_text_table,x
000F13  2  85 rr            sta temp2
000F15  2  BD 63 0F         lda body_text_table+1,x
