00080D  1               ;.segment "EXEHDR"
00080D  1               ;    ; This header structure contains exactly 13 bytes ($000D) to match the memory size
00080D  1               ;    .word $080B         ; 2 bytes - Address link pointer
00080D  1               ;    .word 10            ; 2 bytes - BASIC Line number 10
00080D  1               ;    .byte $9E           ; 1 byte  - SYS token
00080D  1               ;    .byte "2061"        ; 4 bytes - ASCII target jump text characters
00080D  1               ;    .byte 0,0,0         ; 3 bytes - Line end flag bytes
00080D  1               ;    .byte 0             ; 1 byte  - Alignment padding byte (Brings total to exactly 13)
00080D  1               
00080D  1               
00080D  1               .segment "CODE"
00080D  1                   ; Code execution starts cleanly right here at address $080D
00080D  1  4C FF 08         jmp exec
