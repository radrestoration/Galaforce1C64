001B7C  2  90 0B         BCC not_new_high
001B7E  2               copy_to_high:
001B7E  2  BD 2D 06      LDA myscore,X
001B81  2  9D 34 06      STA hiscore,X
001B84  2  E8            INX
001B85  2  E0 07         CPX #7
001B87  2  90 F5         BCC copy_to_high
001B89  2               not_new_high:
001B89  2  60            RTS
001B8A  2               
001B8A  2               reset_score_to_0:
001B8A  2  A0 06         LDY #6
001B8C  2  A9 00         LDA #0
001B8E  2               zero_my_score:
001B8E  2  99 2D 06      STA myscore,Y
001B91  2  88            DEY
001B92  2  10 FA         BPL zero_my_score
001B94  2  A2 91         LDX #24*6+1
001B96  2               clr_score_screen:
001B96  2  9D 8F 30      STA $308F,X
001B99  2  CA            DEX
001B9A  2  D0 FA         BNE clr_score_screen
001B9C  2  A9 20         LDA #$20
001B9E  2  85 rr         STA screen
001BA0  2  A9 31         LDA #$31
001BA2  2  85 rr         STA screen+1
001BA4  2  A2 06         LDX #6
001BA6  2  4C AB 1A      JMP print_scores
001BA9  2               
001BA9  2               toggle_demo_direct:
001BA9  2  AD 48 06      LDA demo_direction
001BAC  2  49 80         EOR #$80
001BAE  2  8D 48 06      STA demo_direction
001BB1  2  60            RTS
001BB2  2               
001BB2  2               ; Points awarded for aliens
001BB2  2               ; (divided by ten)
001BB2  2               
001BB2  2               alien_score:
001BB2  2  02           .byte 2
001BB3  2  02           .byte 2
001BB4  2  02           .byte 2
001BB5  2  02           .byte 2
001BB6  2  04           .byte 4
001BB7  2  08           .byte 8
001BB8  2  04           .byte 4
001BB9  2  04           .byte 4
001BBA  2  06           .byte 6
001BBB  2  08           .byte 8
001BBC  2  08           .byte 8
001BBD  2  08           .byte 8
