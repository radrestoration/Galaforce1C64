001BBE  2               ;;
001BBE  2               
001BBE  2               ;; REM SAVE"ROUT4"
001BBE  2               ;; B%=P%
001BBE  2               ;; [OPT pass
001BBE  2               
001BBE  2               message_loop:
001BBE  2  A0 FF         LDY #$FF
001BC0  2  A9 00         LDA #0
001BC2  2  85 rr         STA temp4
001BC4  2  38            SEC
001BC5  2  AE 3D 06      LDX curwave
001BC8  2  E8            INX
001BC9  2  8A            TXA
001BCA  2               sub10:
001BCA  2  C8            INY
001BCB  2  C9 0A         CMP #10
001BCD  2  90 04         BCC save_wave_text
001BCF  2  E9 0A         SBC #10
001BD1  2  B0 F7         BCS sub10
001BD3  2               save_wave_text:
001BD3  2  8C C6 21      STY wave_text
001BD6  2  8D C7 21      STA wave_text+1
001BD9  2  A0 06         LDY #6
001BDB  2  20 EE 20      JSR prnstr
001BDE  2  18            CLC
001BDF  2  20 7E 1C      JSR completion_message
001BE2  2               
001BE2  2               wait_loop:
001BE2  2  20 22 1C      JSR escape
001BE5  2  AD 2C 06      LDA myst
001BE8  2  30 18         BMI esc_exit
001BEA  2  20 EB 19      JSR move_my_base
001BED  2  20 B3 1D      JSR movestars
001BF0  2  20 A7 1C      JSR rand
001BF3  2  20 53 1E      JSR process_my_bombs
001BF6  2  20 BE 16      JSR pause
001BF9  2  A2 14         LDX #20
001BFB  2  20 B5 16      JSR delay2
001BFE  2  C6 rr         DEC temp4
001C00  2  D0 E0         BNE wait_loop
001C02  2               esc_exit:
001C02  2  38            SEC
001C03  2  20 7E 1C      JSR completion_message
001C06  2  A0 06         LDY #6
001C08  2  4C EE 20      JMP prnstr
001C0B  2               
001C0B  2               end_message:
001C0B  2               ;LDY#12 JSRprnstr
001C0B  2  20 DF 27      JSR title
001C0E  2  A0 0E         LDY #14
001C10  2  20 EE 20      JSR prnstr
001C13  2  A0 0A         LDY #10
001C15  2  20 EE 20      JSR prnstr
001C18  2  A0 1E         LDY #30
001C1A  2  20 EE 20      JSR prnstr
001C1D  2  A0 14         LDY #20
001C1F  2  4C EE 20      JMP prnstr
001C22  2               
001C22  2               escape:
001C22  2  AD 46 06      LDA demo_flag
001C25  2  10 06         BPL not_demomode
001C27  2  20 69 1C      JSR chk_spc_fire
001C2A  2  F0 08         BEQ test_if_already_dead
001C2C  2  60            RTS
001C2D  2               not_demomode:
001C2D  2  A2 8F         LDX #$8F
001C2F  2  20 A9 16      JSR check_key
001C32  2  D0 10         BNE no_escape
001C34  2               test_if_already_dead:
001C34  2  AD 2C 06      LDA myst
001C37  2  30 0B         BMI no_escape
001C39  2  20 86 22      JSR liveson
001C3C  2  A9 00         LDA #0
001C3E  2  8D 29 06      STA lives
001C41  2  4C D2 18      JMP crash
001C44  2               no_escape:
001C44  2  60            RTS
001C45  2               
001C45  2               game_over_loop:
001C45  2  2C 46 06      BIT demo_flag
001C48  2  30 FA         BMI no_escape
001C4A  2  A0 0E         LDY #14
001C4C  2  20 BB 23      JSR StartTune
001C4F  2  A0 08         LDY #8
001C51  2  20 EE 20      JSR prnstr
001C54  2               ;LDA#90 STAcounter
001C54  2               game_over2:
001C54  2  20 B3 1D      JSR movestars
001C57  2  20 BE 16      JSR pause
001C5A  2  A2 19         LDX #25
001C5C  2  20 B5 16      JSR delay2
001C5F  2  20 74 24      JSR MusicTest
001C62  2  D0 F0         BNE game_over2
001C64  2               ;DECcounter BNEgame_over2
001C64  2  A0 08         LDY #8
001C66  2  4C EE 20      JMP prnstr
001C69  2               
001C69  2               chk_spc_fire:
001C69  2  A2 9D         LDX #$9D
001C6B  2  20 A9 16      JSR check_key
001C6E  2  F0 0D         BEQ spc_pressed
001C70  2  A2 00         LDX #0
001C72  2  A9 80         LDA #$80
001C74  2  20 B6 30      JSR osbyte ; read ADC
001C77  2  18            CLC
001C78  2  8A            TXA
001C79  2  29 01         AND #1
001C7B  2  49 01         EOR #1
001C7D  2               spc_pressed:
001C7D  2  60            RTS
001C7E  2               
001C7E  2               
001C7E  2               completion_message:
001C7E  2  08            PHP
001C7F  2  AD 3D 06      LDA curwave
001C82  2  AA            TAX
001C83  2  29 0F         AND #$F
001C85  2  D0 1E         BNE exit_compl
001C87  2  8A            TXA
001C88  2  4A            LSR A
001C89  2  4A            LSR A
001C8A  2  4A            LSR A
001C8B  2  F0 18         BEQ exit_compl
001C8D  2  2C 4B 06      BIT sixteen_flag
001C90  2  30 13         BMI exit_compl
001C92  2  18            CLC
001C93  2  69 14         ADC #20
001C95  2  A8            TAY
001C96  2  C0 1C         CPY #28
001C98  2  B0 0B         BCS exit_compl
001C9A  2  28            PLP
001C9B  2  90 05         BCC not_second_call
001C9D  2  A9 FF         LDA #$FF
001C9F  2  8D 4B 06      STA sixteen_flag
001CA2  2               not_second_call:
