002069  1               .include "src-c64/CHARP.asm"
002069  2               ;;
002069  2               ;; Galaforce 1 ( BBC Micro ) from the original 6502 source code, adapted to assemble using beebasm
002069  2               ;;
002069  2               ;; (c) Kevin Edwards 1986-2019
002069  2               ;;
002069  2               ;; Twitter @KevEdwardsRetro
002069  2               ;;
002069  2               
002069  2               ;; REM SAVE"CHARP"
002069  2               ;; B%=P%
002069  2               ;; [OPT pass
002069  2               
002069  2               ;; The original BBC routine draws 5x7 glyph pixels directly into a bitmap.
002069  2               ;; The C64 routine below is different: it writes character codes to screen
002069  2               ;; RAM. It cannot reproduce arbitrary BBC pixels or the BBC star field.
002069  2               ;; Keep bitmap/star rendering separate from this text-mode path.
002069  2               ;;
002069  2               
002069  2               
002069  2               .proc prnstr_c64_text
002069  2  B9 6C 21         lda strdat,y
00206C  2  85 rr            sta data
00206E  2  B9 6D 21         lda strdat+1,y
002071  2  85 rr            sta data+1
002073  2               
002073  2                   ; 1. Resolve Destination Screen Row from BBC Address Vector
002073  2  A0 01            ldy #1
002075  2  B1 rr            lda (data),y        ; Fetch high byte of BBC target memory address
002077  2  29 0F            and #$0F            ; Mask out high page boundaries to isolate row position
002079  2  A8               tay                 ; Y = Computed C64 screen row table index
00207A  2               
00207A  2  B9 BC 20         lda c64_lines_low,y
00207D  2  85 rr            sta screen
00207F  2  B9 D5 20         lda c64_lines_high,y
002082  2  85 rr            sta screen+1
002084  2               
002084  2                   ; 2. Adjust for Column Placement Offset
002084  2  A0 00            ldy #0
002086  2  B1 rr            lda (data),y        ; Fetch low byte of BBC target memory address
002088  2  4A               lsr a               ; Compress 80 columns down to fit 40 columns
002089  2  18               clc
