00209A  2               print_character_loop:
00209A  2  A5 rr            lda temp4           ; Check if our character print budget is empty
00209C  2  F0 1D            beq text_printing_finished_label
00209E  2               
00209E  2  B1 rr            lda (data),y        ; Fetch original character index code
0020A0  2               
0020A0  2                   ; 4. Convert Original Font Indices to C64 Character Mappings
0020A0  2                   ; For example: If code is 'A' (10), shift it down to align with C64 layout
0020A0  2  C9 0A            cmp #10
0020A2  2  90 03            bcc write_to_matrix
0020A4  2  38               sec
0020A5  2  E9 09            sbc #9              ; Shift index down so 'A' maps cleanly to character slot 1
0020A7  2               
0020A7  2               write_to_matrix:
0020A7  2  84 rr            sty savey           ; Protect our current string parsing index
0020A9  2  A0 00            ldy #0
0020AB  2  91 rr            sta (screen),y      ; Commit character index directly to C64 Screen RAM
0020AD  2  A4 rr            ldy savey           ; Restore string parsing index
0020AF  2               
0020AF  2                   ; Step cursor forward 1 column position
0020AF  2  E6 rr            inc screen
0020B1  2  D0 02            bne :+
0020B3  2  E6 rr            inc screen+1
0020B5  2               :
0020B5  2  C6 rr            dec temp4           ; Subtract 1 character from our remaining counter budget
0020B7  2  C8               iny                 ; Advance reading pointer to the next byte in the data string
0020B8  2  4C 9A 20         jmp print_character_loop
